<!--
  FrameForge's mark: a print in a mat. The warm-white mat is the same frame the app draws around a selected photo
  (Color.Mat); the print is the accent blue, like a cyanotype. The mat is a little deeper at the bottom, as framers cut
  them. Drawn on a 64-unit grid on a dark tile (Color.Panel), so it reads on light and dark taskbars.

  This file is the one source for the logo. The app uses it directly; the app icon (Assets/FrameForge.ico) and the
  splash image (Assets/Splash.png) are rendered from it by `FrameForge.Evaluation brand` (see docs/brand.md). It uses
  literal colours, not theme resources, so that tool can load it on its own.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The mark on its tile: app icon, splash, loading state -->
    <DrawingImage x:Key="Brand.Mark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Tile -->
                <GeometryDrawing Brush="#FF1D1D1D" Geometry="M14,0 H50 A14,14 0 0 1 64,14 V50 A14,14 0 0 1 50,64 H14 A14,14 0 0 1 0,50 V14 A14,14 0 0 1 14,0 Z" />
                <!-- Mat: 6 units at the sides and top, 10 at the bottom -->
                <GeometryDrawing Brush="#FFEAE6DF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="15,11,34,42" RadiusX="2" RadiusY="2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Print -->
                <GeometryDrawing Brush="#FF5AA2D8">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="21,17,22,26" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- The mark without its tile, for places that already sit on a dark surface (sidebar wordmark) -->
    <DrawingImage x:Key="Brand.MarkBare">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Keeps the 64-unit frame so it aligns like the tiled mark -->
                <GeometryDrawing Brush="#00000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,64" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFEAE6DF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="10,5,44,54" RadiusX="2.5" RadiusY="2.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF5AA2D8">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="17.7,12.7,28.6,33.4" RadiusX="1.2" RadiusY="1.2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
