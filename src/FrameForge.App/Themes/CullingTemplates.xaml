<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:FrameForge.App.ViewModels"
                    xmlns:conv="clr-namespace:FrameForge.App.Converters"
                    xmlns:decisions="clr-namespace:FrameForge.Core.Decisions;assembly=FrameForge.Core">

    <conv:ColourLabelToBrushConverter x:Key="LabelToBrush" />

    <!--
        Decision badges for a PhotoTileViewModel: state glyph, stars, label swatch with letter.
        Every badge has a glyph or letter, so nothing is conveyed by colour alone.
    -->
    <DataTemplate x:Key="DecisionBadges" DataType="{x:Type vm:PhotoTileViewModel}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="StateGlyph" Text="{Binding StateGlyph}" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RatingText}" Foreground="{StaticResource Brush.Rating}" Margin="0,0,6,0" VerticalAlignment="Center" />
            <Border x:Name="LabelSwatch" Background="{Binding Label, Converter={StaticResource LabelToBrush}}"
                    CornerRadius="2" Padding="4,0" MinWidth="14" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelLetter}" Foreground="#FF15171A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
            </Border>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Decision.State}" Value="{x:Static decisions:CullState.Keep}">
                <Setter TargetName="StateGlyph" Property="Foreground" Value="{StaticResource Brush.Decision.Keep}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Decision.State}" Value="{x:Static decisions:CullState.Review}">
                <Setter TargetName="StateGlyph" Property="Foreground" Value="{StaticResource Brush.Decision.Review}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Decision.State}" Value="{x:Static decisions:CullState.Reject}">
                <Setter TargetName="StateGlyph" Property="Foreground" Value="{StaticResource Brush.Decision.Reject}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Decision.State}" Value="{x:Static decisions:CullState.Unset}">
                <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LabelLetter}" Value="{x:Null}">
                <Setter TargetName="LabelSwatch" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
