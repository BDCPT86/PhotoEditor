<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        FrameForge design system ("viewing booth"). See docs/ui-design-system.md for the rules behind every token.

        THESIS      The photograph is judged here, so the interface is a neutral viewing surround: hue-free greys that
                    never tint colour judgement, and chrome that steps back in tone rather than boxing things in.
        OWN-WORLD   Four tonal steps (canvas → chrome → panel → control), one cyanotype-blue accent for actions and
                    focus, decision colours only where a decision is shown, and a light "print mat" frame for
                    selection: the one signature, readable on any photo without relying on colour.
        RULES       No gradients, glass or glow. Separation comes from tone and spacing; hairlines only where two
                    regions of the same tone meet. Corners stay small (2–6 px): images are never rounded "cards".
    -->

    <!-- ================================================================ Colour: surfaces (neutral, darkest = photos) -->
    <Color x:Key="Color.Canvas">#FF121212</Color>            <!-- photo grid, viewer, compare: where images sit -->
    <Color x:Key="Color.Chrome">#FF191919</Color>            <!-- sidebar, header, footer -->
    <Color x:Key="Color.Panel">#FF1D1D1D</Color>             <!-- side panels, Develop -->
    <Color x:Key="Color.Control">#FF2A2A2A</Color>           <!-- buttons, tracks -->
    <Color x:Key="Color.Control.Hover">#FF333333</Color>
    <Color x:Key="Color.Control.Pressed">#FF232323</Color>
    <Color x:Key="Color.Field">#FF141414</Color>             <!-- text boxes, dropdowns, lists: recessed -->
    <Color x:Key="Color.Popup">#FF262626</Color>             <!-- menus, dropdown lists, tooltips -->
    <Color x:Key="Color.Selected">#FF2B2B2B</Color>          <!-- selected navigation row -->
    <Color x:Key="Color.Hairline">#FF292929</Color>
    <Color x:Key="Color.Stroke">#FF383838</Color>            <!-- field outlines, popup edges -->
    <Color x:Key="Color.Stroke.Hover">#FF4A4A4A</Color>

    <!-- Text -->
    <Color x:Key="Color.Text.Primary">#FFECECEC</Color>
    <Color x:Key="Color.Text.Secondary">#FFA6A6A6</Color>
    <Color x:Key="Color.Text.Tertiary">#FF878787</Color>     <!-- metadata, counts, file names (≥ 4.5:1 on canvas) -->
    <Color x:Key="Color.Text.Disabled">#FF5E5E5E</Color>

    <!-- Accent: cyanotype blue. Actions, focus and "this filter is on"; never decoration. -->
    <Color x:Key="Color.Accent">#FF5AA2D8</Color>
    <Color x:Key="Color.Accent.Hover">#FF72B2E2</Color>
    <Color x:Key="Color.Accent.Pressed">#FF4A8EC2</Color>
    <Color x:Key="Color.Accent.Subtle">#2E5AA2D8</Color>
    <Color x:Key="Color.OnAccent">#FF0B1722</Color>

    <!-- Selection: a print mat, warm white, around the chosen photos -->
    <Color x:Key="Color.Mat">#FFEAE6DF</Color>

    <!-- Status -->
    <Color x:Key="Color.Status.Error">#FFE5695F</Color>
    <Color x:Key="Color.Status.Success">#FF73B777</Color>
    <Color x:Key="Color.Status.Warning">#FFDBA84A</Color>

    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Chrome" Color="{StaticResource Color.Chrome}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.Control}" />
    <SolidColorBrush x:Key="Brush.Control.Hover" Color="{StaticResource Color.Control.Hover}" />
    <SolidColorBrush x:Key="Brush.Control.Pressed" Color="{StaticResource Color.Control.Pressed}" />
    <SolidColorBrush x:Key="Brush.Field" Color="{StaticResource Color.Field}" />
    <SolidColorBrush x:Key="Brush.Popup" Color="{StaticResource Color.Popup}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}" />
    <SolidColorBrush x:Key="Brush.Hairline" Color="{StaticResource Color.Hairline}" />
    <SolidColorBrush x:Key="Brush.Stroke" Color="{StaticResource Color.Stroke}" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="{StaticResource Color.Stroke.Hover}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Mat" Color="{StaticResource Color.Mat}" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource Color.Status.Error}" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}" />
    <!-- Hover tint over any tone; badge backing that stays legible on bright photos -->
    <SolidColorBrush x:Key="Brush.HoverTint" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#C8121212" />

    <!-- Earlier names, kept so every view resolves; they map onto the steps above. -->
    <Color x:Key="Color.Surface.Sunken">#FF121212</Color>
    <Color x:Key="Color.Surface.Base">#FF191919</Color>
    <Color x:Key="Color.Surface.Raised">#FF1D1D1D</Color>
    <Color x:Key="Color.Surface.Hover">#FF2A2A2A</Color>
    <Color x:Key="Color.Border">#FF292929</Color>
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Surface.Base" Color="{StaticResource Color.Chrome}" />
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Control}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Hairline}" />

    <!-- Culling: decision and label colours. Always paired with a glyph or letter, never colour alone. -->
    <SolidColorBrush x:Key="Brush.Decision.Keep" Color="#FF73B777" />
    <SolidColorBrush x:Key="Brush.Decision.Review" Color="#FFDBA84A" />
    <SolidColorBrush x:Key="Brush.Decision.Reject" Color="#FFE5695F" />
    <SolidColorBrush x:Key="Brush.Label.Red" Color="#FFD9534F" />
    <SolidColorBrush x:Key="Brush.Label.Yellow" Color="#FFE3C04B" />
    <SolidColorBrush x:Key="Brush.Label.Green" Color="#FF5DAE63" />
    <SolidColorBrush x:Key="Brush.Label.Blue" Color="#FF4F8FD9" />
    <SolidColorBrush x:Key="Brush.Rating" Color="#FFE6C571" />
    <!-- Histogram (M09): luminance as a quiet fill; the channel lines are desaturated enough not to read as UI accents -->
    <SolidColorBrush x:Key="Brush.Histogram.Luminance" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="Brush.Histogram.Red" Color="#FFE06C5C" />
    <SolidColorBrush x:Key="Brush.Histogram.Green" Color="#FF6FBF73" />
    <SolidColorBrush x:Key="Brush.Histogram.Blue" Color="#FF5B8DEF" />

    <!-- ================================================================ Typography -->
    <!-- Segoe UI Variable on Windows 11, Segoe UI elsewhere. One family; hierarchy comes from size and weight. -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- System icon font: one consistent line-icon family, no bundled assets -->
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Meta">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Section">14</sys:Double>
    <sys:Double x:Key="FontSize.Panel">15</sys:Double>
    <sys:Double x:Key="FontSize.Page">20</sys:Double>
    <sys:Double x:Key="FontSize.Icon">14</sys:Double>

    <!-- Spacing: a 4 px grid. Tight inside a group, generous between groups. -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">24</sys:Double>
    <sys:Double x:Key="Space.6">32</sys:Double>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Popup">6</CornerRadius>

    <!-- Page heading (Settings, About, Library view name) -->
    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Page}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <!-- Side panel and dialog heading -->
    <Style x:Key="Text.PanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Panel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Section heading inside a page or panel -->
    <Style x:Key="Text.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- Group caption in the sidebar ("Library", "Folders"): the one small kicker in the system -->
    <Style x:Key="Text.SidebarHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
        <Setter Property="Margin" Value="20,20,0,6" />
    </Style>
    <Style x:Key="Text.Secondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Explanations under a setting or control -->
    <Style x:Key="Text.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="17" />
    </Style>
    <!-- Counts and numbers: tabular, so columns line up -->
    <Style x:Key="Text.Count" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Text.Status" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Icon}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Shadow for things that float (menus, dropdowns, tooltips): offset and soft, never a glow -->
    <DropShadowEffect x:Key="Shadow.Popup" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#FF000000" />

    <!-- ================================================================ Focus -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" RadiusX="5" RadiusY="5" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Buttons -->
    <!-- Secondary (default): a quiet filled control, no outline. -->
    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Control}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Control.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                            <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary: the one main action of a panel or empty state (Export, Save, Import when empty). -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{StaticResource Brush.Accent}" CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Control}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet: toolbar and inline actions. No fill until hovered. -->
    <Style x:Key="Button.Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Control}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Control.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon-only quiet button: square, its tooltip names the action. Content is a glyph from Font.Icon or the UI font. -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Quiet}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Icon}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text-only link action inside a row (Cancel, Retry, Clear) -->
    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Background="Transparent" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact icon buttons (Develop header, rotate): quiet squares using the UI font's glyphs. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Button.Quiet}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Toggle buttons (Develop, Before, Crop, Show, Refine): when on, an accent-tinted fill and accent text. -->
    <Style TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Control}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Control.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- ================================================================ Panel sections (Develop) -->
    <!-- A full-width header row with a chevron; a hairline separates sections that share one tone. -->
    <Style x:Key="PanelSection" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      FocusVisualStyle="{StaticResource FocusVisual}" Cursor="Hand"
                                      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Row" Background="Transparent" Padding="0,12,0,10" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0">
                                        <DockPanel>
                                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Text.Icon}" Text="&#xE70D;" FontSize="10"
                                                       Foreground="{StaticResource Brush.Text.Tertiary}" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                       FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Margin="0,0,0,14" Visibility="Collapsed" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Lists -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Plain list rows (preset lists): selected = raised tone + semibold, no system blue. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.HoverTint}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Text input -->
    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Stroke.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Hairline}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Check box and radio button -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" VerticalAlignment="Top" Margin="0,1,0,0"
                                Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Stroke.Hover}" BorderThickness="1" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Mark" Style="{StaticResource Text.Icon}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource Brush.OnAccent}" Visibility="Collapsed" />
                        </Border>
                        <Border x:Name="Ring" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Top" Margin="-2,-1,-2,0"
                                BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Text.Secondary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Ellipse x:Name="Outer" Fill="{StaticResource Brush.Field}" Stroke="{StaticResource Brush.Stroke.Hover}" StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Brush.OnAccent}" Visibility="Collapsed" />
                            <Ellipse x:Name="Ring" Margin="-3" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource Brush.Text.Secondary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Outer" Property="Fill" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                            <Setter TargetName="Outer" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Slider -->
    <!-- A thin neutral track and a light thumb. No coloured fill: most edit sliders are centred on zero. -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="16" Height="16" Background="Transparent">
                        <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{StaticResource Brush.Text.Primary}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Brush.Accent.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border x:Name="Rail" Height="3" CornerRadius="1.5" Background="{StaticResource Brush.Control.Hover}" VerticalAlignment="Center" Margin="6,0" />
                        <Border x:Name="Focus" Height="3" CornerRadius="1.5" Background="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="6,0" Visibility="Collapsed" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackButton}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackButton}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Keyboard focus: the rail turns accent, so arrow-key adjustments show where they land. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Progress -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Control.Hover}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ================================================================ Tooltip -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="4,0,4,8" Padding="9,5" MaxWidth="360" CornerRadius="{StaticResource Radius.Control}"
                            Background="{StaticResource Brush.Popup}" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                            Effect="{StaticResource Shadow.Popup}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Context menus -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="0,0,10,12" Padding="4" MinWidth="200" CornerRadius="{StaticResource Radius.Popup}"
                            Background="{StaticResource Brush.Popup}" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                            Effect="{StaticResource Shadow.Popup}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{StaticResource Brush.Stroke}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Menu rows: optional check, header, shortcut (InputGestureText) and a submenu chevron. -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Row" Background="Transparent" CornerRadius="3" Padding="8,6" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Style="{StaticResource Text.Icon}" Text="&#xE73E;" FontSize="11" HorizontalAlignment="Left"
                                           Foreground="{StaticResource Brush.Accent}" Visibility="Hidden" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Margin="24,0,0,0" Text="{TemplateBinding InputGestureText}" FontSize="{StaticResource FontSize.Meta}"
                                           Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Chevron" Grid.Column="3" Style="{StaticResource Text.Icon}" Text="&#xE76C;" FontSize="9"
                                           Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Right" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-5" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
                            <Border Margin="0,0,10,12" Padding="4" MinWidth="160" CornerRadius="{StaticResource Radius.Popup}"
                                    Background="{StaticResource Brush.Popup}" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                                    Effect="{StaticResource Shadow.Popup}" Grid.IsSharedSizeScope="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Scrollbars -->
    <!-- Thin and neutral; the default light ones dominate a dark photo grid. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Root" Background="{StaticResource Brush.Control.Hover}" CornerRadius="3" Margin="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Stroke.Hover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Text.Tertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ Sidebar navigation -->
    <!-- Rows: hover = tint, selected = raised tone + primary text. No coloured bars. -->
    <Style x:Key="NavigationListItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" Margin="8,1" Padding="12,6" CornerRadius="{StaticResource Radius.Control}"
                            BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.HoverTint}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Selected}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavigationList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavigationListItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Settings / About at the foot of the sidebar: same look as a navigation row; Tag = true when it is the page shown. -->
    <Style x:Key="NavigationButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" Margin="8,1" Padding="12,6" CornerRadius="{StaticResource Radius.Control}"
                            BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.HoverTint}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Selected}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Photo grid tile -->
    <!--
        The signature: selection is a warm-white print mat around the photo (readable on any image, not colour-coded).
        Keyboard focus adds a thin accent ring outside the mat, so the focused photo stands out within a multi-selection.
        Hover lifts the cell one tone. No transitions: culling must never wait on an animation.
    -->
    <Style x:Key="PhotoTileItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="FocusRing" Margin="3" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" SnapsToDevicePixels="True">
                        <Border x:Name="Mat" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4" Padding="4" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Mat" Property="Background" Value="{StaticResource Brush.Chrome}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Mat" Property="Background" Value="{StaticResource Brush.Panel}" />
                            <Setter TargetName="Mat" Property="BorderBrush" Value="{StaticResource Brush.Mat}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Segmented control -->
    <!-- One recessed track per group holding borderless options; the chosen option is a raised pill with primary text. -->
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.HoverTint}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Caption above a filter group: small, sentence case. -->
    <Style x:Key="Text.FilterCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Margin" Value="2,0,0,3" />
    </Style>

    <!-- ================================================================ Drop-down -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3" SnapsToDevicePixels="True">
                        <DockPanel>
                            <TextBlock x:Name="Check" DockPanel.Dock="Left" Width="18" Style="{StaticResource Text.Icon}" HorizontalAlignment="Left"
                                       Text="&#xE73E;" FontSize="10" Foreground="{StaticResource Brush.Accent}" Visibility="Hidden" />
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Track" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE70D;" FontSize="10" HorizontalAlignment="Right" Margin="0,0,10,0"
                                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Stroke.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Shown" IsHitTestVisible="False" Margin="10,0,28,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Border x:Name="Focus" CornerRadius="{StaticResource Radius.Control}" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Margin="0,4,10,12" Padding="4" CornerRadius="{StaticResource Radius.Popup}" SnapsToDevicePixels="True"
                                    Background="{StaticResource Brush.Popup}" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                                    Effect="{StaticResource Shadow.Popup}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="420">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Label colour swatch inside a Segment. -->
    <Style x:Key="LabelSwatch" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <!-- Analysis indicator over a thumbnail: a short glyph on a dark scrim, legible on any photo; the tooltip explains. -->
    <Style x:Key="AnalysisBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Scrim}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="4,1,4,2" />
        <Setter Property="Margin" Value="0,0,3,3" />
    </Style>
    <Style x:Key="Text.AnalysisBadge" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <!-- Side panel surface (export, presets, details, shortcuts): one tone above the canvas, no outline. -->
    <Style x:Key="SidePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Hairline}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Padding" Value="20,14,20,16" />
        <Setter Property="Width" Value="344" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- A grouped block inside a panel or Settings: one tonal step, no outline -->
    <Style x:Key="Surface.Group" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Chrome}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Popup}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
    <!-- Inline confirmation (export into a library folder, model download consent) -->
    <Style x:Key="Surface.Callout" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Control}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Popup}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

</ResourceDictionary>
