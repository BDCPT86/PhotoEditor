<UserControl x:Class="FrameForge.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FrameForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CompareViewModel}"
             Background="{StaticResource Brush.Surface.Sunken}"
             Focusable="True" FocusVisualStyle="{x:Null}"
             AutomationProperties.Name="Compare">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Right" Command="{Binding NextCommand}" />
        <KeyBinding Key="Left" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="Escape" Command="{Binding RequestCloseCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="{StaticResource Brush.Chrome}" Height="48">
            <Button DockPanel.Dock="Left" Style="{StaticResource Button.Quiet}" Margin="12,0,0,0" ToolTip="Back to the grid (Esc)"
                    Command="{Binding RequestCloseCommand}" AutomationProperties.Name="Back to the grid">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Grid" />
                </StackPanel>
            </Button>
            <TextBlock DockPanel.Dock="Right" Margin="16,0" Style="{StaticResource Text.Count}" FontSize="{StaticResource FontSize.Caption}"
                       Text="← →  choose photo   ·   P X V U  decide   ·   1–5  rate   ·   Esc  grid" />
            <TextBlock Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Compare" />
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Panels}" Margin="8,8,8,8" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- One row, one column per photo -->
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ComparePanelViewModel}">
                    <!-- Active panel: the print mat (as for a selected tile) plus "Active" text, not colour alone. -->
                    <Border x:Name="Frame" Margin="4" BorderThickness="2" BorderBrush="Transparent" CornerRadius="4" Padding="4"
                            Background="{StaticResource Brush.Canvas}" Cursor="Hand"
                            AutomationProperties.Name="{Binding Tile.FileName}" AutomationProperties.ItemStatus="{Binding Tile.AccessibleStatus}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick"
                                          Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}" />
                        </Border.InputBindings>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="10,6">
                                <ContentControl DockPanel.Dock="Right" Content="{Binding Tile}" ContentTemplate="{StaticResource DecisionBadges}" Focusable="False" IsTabStop="False" />
                                <!-- The judgements that decide between similar shots, beside the name -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource AnalysisBadge}" Margin="0,0,4,0" Background="{StaticResource Brush.Control}" ToolTip="AI suggested pick in its group (advisory)"
                                            Visibility="{Binding Tile.ShowAiPickBadge, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="AI pick" Foreground="{StaticResource Brush.Decision.Keep}" />
                                    </Border>
                                    <Border Style="{StaticResource AnalysisBadge}" Margin="0,0,4,0" Background="{StaticResource Brush.Control}" ToolTip="Sharpest in its similar group"
                                            Visibility="{Binding Tile.ShowSharpestBadge, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="◆ sharpest" Foreground="{StaticResource Brush.Decision.Keep}" />
                                    </Border>
                                    <Border Style="{StaticResource AnalysisBadge}" Margin="0,0,4,0" Background="{StaticResource Brush.Control}" ToolTip="Likely blurry (heuristic)"
                                            Visibility="{Binding Tile.ShowBlurBadge, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="≈ blurry?" Foreground="{StaticResource Brush.Decision.Review}" />
                                    </Border>
                                    <Border Style="{StaticResource AnalysisBadge}" Margin="0,0,4,0" Background="{StaticResource Brush.Control}" ToolTip="All faces look soft (AI, advisory)"
                                            Visibility="{Binding Tile.ShowFacesSoftBadge, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="☺ faces soft" Foreground="{StaticResource Brush.Decision.Review}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ActiveText" DockPanel.Dock="Left" Text="Active  " FontSize="{StaticResource FontSize.Caption}" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock Text="{Binding Tile.FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Tile.FilePath}" />
                            </DockPanel>
                            <Grid>
                                <Image Source="{Binding Tile.Thumbnail}" Stretch="Uniform" Opacity="0.6" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                <Image x:Name="Photo" Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.Status.Error}"
                                           Text="{Binding Error, StringFormat='⚠ {0}'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.Mat}" />
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource Brush.Panel}" />
                            <Setter TargetName="ActiveText" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tile.IsRejected}" Value="True">
                            <Setter TargetName="Photo" Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
