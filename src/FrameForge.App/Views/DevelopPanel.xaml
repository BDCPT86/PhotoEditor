<UserControl x:Class="FrameForge.App.Views.DevelopPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FrameForge.App.ViewModels"
             xmlns:conv="clr-namespace:FrameForge.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DevelopViewModel}"
             AutomationProperties.Name="Develop">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Values use the UI font with tabular digits, so numbers line up without a monospace costume. -->
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="EditSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Margin" Value="0,2,0,10" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="ToolTip" Value="Double-click to reset" />
            <EventSetter Event="MouseDoubleClick" Handler="OnSliderDoubleClick" />
        </Style>
        <Style x:Key="AutoButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <!-- Masks: small caps-style group label inside a mask's sliders -->
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>
        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SmallIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <!-- A text-only action inside a mask row (Cancel, Retry) -->
        <Style x:Key="InlineAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Mask rows: the selected mask is a raised row with a semibold name (tone and weight, not colour) -->
        <Style x:Key="MaskRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" Padding="10,7,4,7" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.HoverTint}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Control}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Surface.Raised}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
        <DockPanel>
            <!-- Header: title and one compact row of history / compare actions -->
            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="↶" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                            ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" Margin="0,0,4,0" />
                    <Button Style="{StaticResource IconButton}" Content="↷" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                            ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" Margin="0,0,4,0" />
                    <ToggleButton Style="{StaticResource IconToggle}" Content="◐" IsChecked="{Binding ShowOriginal}"
                                  ToolTip="Before / after (hold \ to compare)" AutomationProperties.Name="Show original" Margin="0,0,4,0" />
                    <Button Style="{StaticResource IconButton}" Content="⟲" Command="{Binding ResetAllCommand}"
                            ToolTip="Reset all edits (undoable)" AutomationProperties.Name="Reset all" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Develop" Style="{StaticResource Text.PanelTitle}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Text="Original never changes"
                               ToolTip="Edits are stored separately; the photo file is only read." />
                </StackPanel>
            </DockPanel>

            <!-- Message -->
            <TextBlock DockPanel.Dock="Bottom" Margin="16,8,16,12" TextWrapping="Wrap" FontSize="12" AutomationProperties.AutomationId="DevelopMessage"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                        <Setter Property="Text" Value="{Binding Message}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}" />
                                <Setter Property="Text" Value="{Binding Message, StringFormat='⚠ {0}'}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="16,0,16,8">
                    <!-- Auto: suggestions to choose from; nothing is applied until you accept one -->
                    <Expander Style="{StaticResource PanelSection}" Header="Auto" IsExpanded="{Binding IsAutoSectionOpen}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Shows a few options on the photo. Pick one, or dismiss; nothing changes until you accept." />
                            <WrapPanel>
                                <Button Style="{StaticResource AutoButton}" Content="Light" Command="{Binding AutoLightCommand}"
                                        ToolTip="Suggest exposure, white balance and tone from this photo" AutomationProperties.Name="Auto light" />
                                <Button Style="{StaticResource AutoButton}" Content="Level" Command="{Binding AutoLevelCommand}"
                                        ToolTip="Find the horizon or a long straight line and straighten it" AutomationProperties.Name="Auto level" />
                                <Button Style="{StaticResource AutoButton}" Content="{Binding AutoCropLabel}" Command="{Binding AutoCropCommand}"
                                        ToolTip="Frame the main faces (ratio set under Crop)" AutomationProperties.Name="Auto crop" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Light -->
                    <Expander Style="{StaticResource PanelSection}" Header="Light" IsExpanded="{Binding IsLightSectionOpen}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Exposure, StringFormat={}{0:+0.00;-0.00;0.00} EV}" />
                                <TextBlock Text="Exposure" Style="{StaticResource SliderLabel}" />
                            </DockPanel>
                            <Slider Style="{StaticResource EditSlider}" Tag="Exposure" Minimum="-5" Maximum="5" SmallChange="0.05" LargeChange="0.5"
                                    Value="{Binding Exposure}" AutomationProperties.Name="Exposure" />

                            <DockPanel>
                                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Contrast, StringFormat={}{0:+0;-0;0}}" />
                                <TextBlock Text="Contrast" Style="{StaticResource SliderLabel}" />
                            </DockPanel>
                            <Slider Style="{StaticResource EditSlider}" Tag="Contrast" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding Contrast}" AutomationProperties.Name="Contrast" />

                            <DockPanel>
                                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Highlights, StringFormat={}{0:+0;-0;0}}" />
                                <TextBlock Text="Highlights" Style="{StaticResource SliderLabel}" />
                            </DockPanel>
                            <Slider Style="{StaticResource EditSlider}" Tag="Highlights" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding Highlights}" AutomationProperties.Name="Highlights"
                                    ToolTip="Negative darkens bright areas. Detail already clipped in the JPEG cannot come back." />

                            <DockPanel>
                                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Shadows, StringFormat={}{0:+0;-0;0}}" />
                                <TextBlock Text="Shadows" Style="{StaticResource SliderLabel}" />
                            </DockPanel>
                            <Slider Style="{StaticResource EditSlider}" Tag="Shadows" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding Shadows}" AutomationProperties.Name="Shadows" />
                        </StackPanel>
                    </Expander>

                    <!-- Colour -->
                    <Expander Style="{StaticResource PanelSection}" Header="Colour" IsExpanded="{Binding IsColourSectionOpen}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Temperature, StringFormat={}{0:+0;-0;0}}" />
                                <TextBlock Text="Temperature" Style="{StaticResource SliderLabel}" />
                            </DockPanel>
                            <Slider Style="{StaticResource EditSlider}" Tag="Temperature" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding Temperature}" AutomationProperties.Name="Temperature"
                                    ToolTip="Cooler ← → warmer, relative to the photo as shot" />

                            <DockPanel>
                                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Tint, StringFormat={}{0:+0;-0;0}}" />
                                <TextBlock Text="Tint" Style="{StaticResource SliderLabel}" />
                            </DockPanel>
                            <Slider Style="{StaticResource EditSlider}" Tag="Tint" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding Tint}" AutomationProperties.Name="Tint" ToolTip="Greener ← → more magenta" />

                            <DockPanel>
                                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Vibrance, StringFormat={}{0:+0;-0;0}}" />
                                <TextBlock Text="Vibrance" Style="{StaticResource SliderLabel}" />
                            </DockPanel>
                            <Slider Style="{StaticResource EditSlider}" Tag="Vibrance" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding Vibrance}" AutomationProperties.Name="Vibrance" ToolTip="Mostly affects muted colours" />

                            <DockPanel>
                                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Saturation, StringFormat={}{0:+0;-0;0}}" />
                                <TextBlock Text="Saturation" Style="{StaticResource SliderLabel}" />
                            </DockPanel>
                            <Slider Style="{StaticResource EditSlider}" Tag="Saturation" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding Saturation}" AutomationProperties.Name="Saturation" />
                        </StackPanel>
                    </Expander>

                    <!-- Masks: adjust part of the photo. The overall look comes first, then areas are refined. -->
                    <Expander Style="{StaticResource PanelSection}" Header="Masks" IsExpanded="{Binding IsMasksSectionOpen}">
                        <StackPanel DataContext="{Binding Masks}">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Text.Secondary}" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="Add" Style="{StaticResource SliderLabel}" />
                            </DockPanel>
                            <WrapPanel>
                                <Button Style="{StaticResource AutoButton}" Content="Subject" Command="{Binding AddSubjectCommand}"
                                        ToolTip="Select the main people (the largest ones), with a local model" AutomationProperties.Name="Add subject mask" />
                                <Button Style="{StaticResource AutoButton}" Content="Sky" Command="{Binding AddSkyCommand}"
                                        ToolTip="Select blue or overcast sky from the top edge (no model)" AutomationProperties.Name="Add sky mask" />
                                <Button Style="{StaticResource AutoButton}" Content="Background" Command="{Binding AddBackgroundCommand}"
                                        ToolTip="Everything except the main people" AutomationProperties.Name="Add background mask" />
                            </WrapPanel>

                            <!-- Why Subject and Background are off -->
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" Foreground="{StaticResource Brush.Text.Secondary}"
                                       AutomationProperties.AutomationId="SubjectUnavailable">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SubjectUnavailable, StringFormat='⚠ {0}'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SubjectUnavailable}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="Adjust one part of the photo: add a mask, then move its sliders. Up to 8 masks."
                                       Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />

                            <!-- The masks -->
                            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource MaskRow}" Background="Transparent" BorderThickness="0"
                                     Margin="0,0,0,8" Padding="0,2" AutomationProperties.Name="Masks"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LocalAdjustmentViewModel}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                <ToggleButton Style="{StaticResource SmallIconToggle}" Content="◑" IsChecked="{Binding Invert}" Margin="0,0,4,0"
                                                              ToolTip="Invert: adjust everything outside this mask instead" AutomationProperties.Name="Invert mask" />
                                                <Button Style="{StaticResource SmallIconButton}" Content="✕"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" ToolTip="Delete this mask (undoable)" AutomationProperties.Name="Delete mask" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" />
                                                <!-- Status: computing (with Cancel), ready (what was found), or unavailable (with Retry) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                            Visibility="{Binding IsComputing, Converter={StaticResource BoolToVisibility}}">
                                                    <ProgressBar Width="56" IsIndeterminate="True" VerticalAlignment="Center" AutomationProperties.Name="Computing mask" />
                                                    <TextBlock Margin="8,0,0,0" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Brush.Text.Secondary}" Text="{Binding StatusText}" />
                                                    <Button Style="{StaticResource InlineAction}" Content="Cancel"
                                                            Command="{Binding DataContext.CancelComputingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="Cancel computing the mask" />
                                                </StackPanel>
                                                <TextBlock FontSize="12" FontWeight="Normal" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{StaticResource Brush.Text.Secondary}" Text="{Binding Summary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsComputing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Margin="0,2,0,0" Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontSize="12" FontWeight="Normal" TextWrapping="Wrap" Foreground="{StaticResource Brush.Status.Error}"
                                                               Text="{Binding Unavailable, StringFormat='⚠ {0}'}" AutomationProperties.LiveSetting="Polite" />
                                                    <Button Style="{StaticResource InlineAction}" Margin="0,2,0,0" HorizontalAlignment="Left" Content="Retry"
                                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="Retry computing the mask" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- The selected mask: look at it, refine it with clicks, and its own sliders -->
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <WrapPanel Margin="0,0,0,2">
                                    <ToggleButton Content="Show (O)" IsChecked="{Binding ShowOverlay}" Margin="0,0,6,6" MinWidth="0" Padding="10,6"
                                                  ToolTip="Show the selected mask on the photo: outside it is darkened, its edge outlined"
                                                  AutomationProperties.Name="Show mask" />
                                    <ToggleButton Content="Refine (M)" IsChecked="{Binding IsRefining}" Margin="0,0,6,6" MinWidth="0" Padding="10,6"
                                                  ToolTip="Click the photo to add to the mask; Alt+click or right-click to remove. Esc stops."
                                                  AutomationProperties.Name="Refine mask" />
                                    <Button Content="Clear clicks" Command="{Binding ClearClicksCommand}" Margin="0,0,6,6" MinWidth="0" Padding="10,6"
                                            ToolTip="{Binding Selected.ClicksText}" />
                                </WrapPanel>

                                <StackPanel DataContext="{Binding Selected}">
                                    <TextBlock Style="{StaticResource GroupLabel}" Margin="0,0,0,4">
                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · light" />
                                    </TextBlock>
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Exposure, StringFormat={}{0:+0.00;-0.00;0.00} EV}" />
                                        <TextBlock Text="Exposure" Style="{StaticResource SliderLabel}" />
                                    </DockPanel>
                                    <Slider Style="{StaticResource EditSlider}" Tag="Exposure" Minimum="-5" Maximum="5" SmallChange="0.05" LargeChange="0.5"
                                            Value="{Binding Exposure}" AutomationProperties.Name="Mask exposure" />
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Contrast, StringFormat={}{0:+0;-0;0}}" />
                                        <TextBlock Text="Contrast" Style="{StaticResource SliderLabel}" />
                                    </DockPanel>
                                    <Slider Style="{StaticResource EditSlider}" Tag="Contrast" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                            Value="{Binding Contrast}" AutomationProperties.Name="Mask contrast" />
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Highlights, StringFormat={}{0:+0;-0;0}}" />
                                        <TextBlock Text="Highlights" Style="{StaticResource SliderLabel}" />
                                    </DockPanel>
                                    <Slider Style="{StaticResource EditSlider}" Tag="Highlights" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                            Value="{Binding Highlights}" AutomationProperties.Name="Mask highlights" />
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Shadows, StringFormat={}{0:+0;-0;0}}" />
                                        <TextBlock Text="Shadows" Style="{StaticResource SliderLabel}" />
                                    </DockPanel>
                                    <Slider Style="{StaticResource EditSlider}" Tag="Shadows" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                            Value="{Binding Shadows}" AutomationProperties.Name="Mask shadows" />

                                    <TextBlock Style="{StaticResource GroupLabel}">
                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · colour" />
                                    </TextBlock>
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Temperature, StringFormat={}{0:+0;-0;0}}" />
                                        <TextBlock Text="Temperature" Style="{StaticResource SliderLabel}" />
                                    </DockPanel>
                                    <Slider Style="{StaticResource EditSlider}" Tag="Temperature" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                            Value="{Binding Temperature}" AutomationProperties.Name="Mask temperature" />
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Tint, StringFormat={}{0:+0;-0;0}}" />
                                        <TextBlock Text="Tint" Style="{StaticResource SliderLabel}" />
                                    </DockPanel>
                                    <Slider Style="{StaticResource EditSlider}" Tag="Tint" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                            Value="{Binding Tint}" AutomationProperties.Name="Mask tint" />
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Vibrance, StringFormat={}{0:+0;-0;0}}" />
                                        <TextBlock Text="Vibrance" Style="{StaticResource SliderLabel}" />
                                    </DockPanel>
                                    <Slider Style="{StaticResource EditSlider}" Tag="Vibrance" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                            Value="{Binding Vibrance}" AutomationProperties.Name="Mask vibrance" />
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Saturation, StringFormat={}{0:+0;-0;0}}" />
                                        <TextBlock Text="Saturation" Style="{StaticResource SliderLabel}" />
                                    </DockPanel>
                                    <Slider Style="{StaticResource EditSlider}" Tag="Saturation" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                            Value="{Binding Saturation}" AutomationProperties.Name="Mask saturation" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Crop and straighten -->
                    <Expander Style="{StaticResource PanelSection}" Header="Crop and straighten" IsExpanded="{Binding IsCropSectionOpen}">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <ToggleButton Content="Crop (R)" IsChecked="{Binding IsCropMode}" Margin="0,0,6,6" MinWidth="0" Padding="12,6"
                                              AutomationProperties.Name="Crop mode"
                                              ToolTip="Shows the whole frame; drag the rectangle or its corners. Arrow keys move it, Ctrl+arrows resize." />
                                <Button Style="{StaticResource IconButton}" Content="⟲" Command="{Binding RotateLeftCommand}" Margin="0,0,6,6"
                                        ToolTip="Rotate 90° counter-clockwise" AutomationProperties.Name="Rotate left" />
                                <Button Style="{StaticResource IconButton}" Content="⟳" Command="{Binding RotateRightCommand}" Margin="0,0,6,6"
                                        ToolTip="Rotate 90° clockwise" AutomationProperties.Name="Rotate right" />
                                <Button Content="Reset crop" Command="{Binding ResetCropCommand}" Margin="0,0,6,6" MinWidth="0" Padding="12,6" />
                            </WrapPanel>
                            <TextBlock Text="Aspect ratio" Style="{StaticResource SliderLabel}" Margin="0,0,0,4" />
                            <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,8" AutomationProperties.Name="Crop aspect ratio">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Padding="7,2" GroupName="CropAspect" Content="Free"
                                                 IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Free}}" />
                                    <RadioButton Style="{StaticResource Segment}" Padding="7,2" GroupName="CropAspect" Content="Original"
                                                 IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Original}}" />
                                    <RadioButton Style="{StaticResource Segment}" Padding="7,2" GroupName="CropAspect" Content="1:1" AutomationProperties.Name="Square"
                                                 IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Square}}" />
                                    <RadioButton Style="{StaticResource Segment}" Padding="7,2" GroupName="CropAspect" Content="4:5" AutomationProperties.Name="4 by 5 portrait"
                                                 IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Portrait4x5}}" />
                                    <RadioButton Style="{StaticResource Segment}" Padding="7,2" GroupName="CropAspect" Content="3:2" AutomationProperties.Name="3 by 2"
                                                 IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Classic3x2}}" />
                                    <RadioButton Style="{StaticResource Segment}" Padding="7,2" GroupName="CropAspect" Content="16:9" AutomationProperties.Name="16 by 9"
                                                 IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Wide16x9}}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding CropText}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,0,0,8" />
                            <DockPanel>
                                <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Straighten, StringFormat={}{0:+0.0;-0.0;0.0}°}" />
                                <TextBlock Text="Straighten" Style="{StaticResource SliderLabel}" />
                            </DockPanel>
                            <Slider Style="{StaticResource EditSlider}" Tag="Straighten" Minimum="-45" Maximum="45" SmallChange="0.1" LargeChange="1"
                                    Value="{Binding Straighten}" AutomationProperties.Name="Straighten"
                                    ToolTip="Rotates the picture and crops in so no blank corners show" />
                        </StackPanel>
                    </Expander>

                    <!-- Presets -->
                    <Expander Style="{StaticResource PanelSection}" Header="Presets" IsExpanded="{Binding IsPresetsSectionOpen}">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Margin="0,0,0,6"
                                     MinHeight="48" MaxHeight="140" AutomationProperties.Name="Preset to apply" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Apply" Command="{Binding ApplyPresetCommand}" Margin="0,0,6,0" MinWidth="0" Padding="12,6" />
                                <Button Content="Delete" Command="{Binding DeletePresetCommand}" MinWidth="0" Padding="12,6"
                                        ToolTip="Delete the selected preset (edits already applied stay)" />
                            </StackPanel>
                            <TextBlock Text="Save current settings as a preset" Style="{StaticResource SliderLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,0,0,6"
                                     AutomationProperties.Name="New preset name" />
                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox Content="Exposure" IsChecked="{Binding PresetIncludesExposure}" Margin="0,0,10,4" />
                                <CheckBox Content="White balance" IsChecked="{Binding PresetIncludesWhiteBalance}" Margin="0,0,10,4" />
                                <CheckBox Content="Tone" IsChecked="{Binding PresetIncludesTone}" Margin="0,0,10,4" ToolTip="Contrast, highlights, shadows" />
                                <CheckBox Content="Colour" IsChecked="{Binding PresetIncludesColour}" Margin="0,0,10,4" ToolTip="Saturation, vibrance" />
                                <CheckBox Content="Crop and rotation" IsChecked="{Binding PresetIncludesGeometry}" Margin="0,0,10,4" />
                                <CheckBox Content="Masks" IsChecked="{Binding PresetIncludesMasks}" Margin="0,0,10,4"
                                          ToolTip="The masks and their settings; each photo gets its own mask, and clicks are not copied" />
                            </WrapPanel>
                            <Button Content="Save preset" HorizontalAlignment="Left" Command="{Binding SavePresetCommand}" MinWidth="0" Padding="12,6" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
