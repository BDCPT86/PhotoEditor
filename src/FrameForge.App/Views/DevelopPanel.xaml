<UserControl x:Class="FrameForge.App.Views.DevelopPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FrameForge.App.ViewModels"
             xmlns:conv="clr-namespace:FrameForge.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DevelopViewModel}"
             AutomationProperties.Name="Develop">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />

        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="EditSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Margin" Value="0,2,0,10" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="ToolTip" Value="Double-click to reset" />
            <EventSetter Event="MouseDoubleClick" Handler="OnSliderDoubleClick" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionLabel}">
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Surface.Raised}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
        <DockPanel>
            <!-- Header: history and before/after -->
            <StackPanel DockPanel.Dock="Top" Margin="16,12,16,4">
                <DockPanel>
                    <TextBlock Text="Develop" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"
                               Text="non-destructive" ToolTip="The original file is never changed; edits are stored separately." />
                </DockPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="↶ Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="0,0,6,6" ToolTip="Undo (Ctrl+Z)" />
                    <Button Content="↷ Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Margin="0,0,6,6" ToolTip="Redo (Ctrl+Y)" />
                    <ToggleButton Content="Before" IsChecked="{Binding ShowOriginal}" Margin="0,0,6,6" ToolTip="Show the original (\)"
                                  AutomationProperties.Name="Show original" />
                    <Button Content="Reset all" Command="{Binding ResetAllCommand}" Margin="0,0,6,6" ToolTip="Back to the original (undoable)" />
                </WrapPanel>
            </StackPanel>

            <!-- Message -->
            <TextBlock DockPanel.Dock="Bottom" Margin="16,8,16,12" TextWrapping="Wrap" FontSize="12" AutomationProperties.AutomationId="DevelopMessage">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                        <Setter Property="Text" Value="{Binding Message}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}" />
                                <Setter Property="Text" Value="{Binding Message, StringFormat='⚠ {0}'}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="16,0,16,8">
                    <!-- Light -->
                    <TextBlock Text="Light" Style="{StaticResource Section}" />
                    <DockPanel>
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Exposure, StringFormat={}{0:+0.00;-0.00;0.00} EV}" />
                        <TextBlock Text="Exposure" Style="{StaticResource SliderLabel}" />
                    </DockPanel>
                    <Slider Style="{StaticResource EditSlider}" Tag="Exposure" Minimum="-5" Maximum="5" SmallChange="0.05" LargeChange="0.5"
                            Value="{Binding Exposure}" AutomationProperties.Name="Exposure" />

                    <DockPanel>
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Contrast, StringFormat={}{0:+0;-0;0}}" />
                        <TextBlock Text="Contrast" Style="{StaticResource SliderLabel}" />
                    </DockPanel>
                    <Slider Style="{StaticResource EditSlider}" Tag="Contrast" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                            Value="{Binding Contrast}" AutomationProperties.Name="Contrast" />

                    <DockPanel>
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Highlights, StringFormat={}{0:+0;-0;0}}" />
                        <TextBlock Text="Highlights" Style="{StaticResource SliderLabel}" />
                    </DockPanel>
                    <Slider Style="{StaticResource EditSlider}" Tag="Highlights" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                            Value="{Binding Highlights}" AutomationProperties.Name="Highlights"
                            ToolTip="Negative darkens bright areas. Detail that is already clipped in the JPEG cannot come back." />

                    <DockPanel>
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Shadows, StringFormat={}{0:+0;-0;0}}" />
                        <TextBlock Text="Shadows" Style="{StaticResource SliderLabel}" />
                    </DockPanel>
                    <Slider Style="{StaticResource EditSlider}" Tag="Shadows" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                            Value="{Binding Shadows}" AutomationProperties.Name="Shadows" />

                    <!-- Colour -->
                    <TextBlock Text="Colour" Style="{StaticResource Section}" />
                    <DockPanel>
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Temperature, StringFormat={}{0:+0;-0;0}}" />
                        <TextBlock Text="Temperature" Style="{StaticResource SliderLabel}" />
                    </DockPanel>
                    <Slider Style="{StaticResource EditSlider}" Tag="Temperature" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                            Value="{Binding Temperature}" AutomationProperties.Name="Temperature"
                            ToolTip="Cooler ← → warmer, relative to the photo as shot" />

                    <DockPanel>
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Tint, StringFormat={}{0:+0;-0;0}}" />
                        <TextBlock Text="Tint" Style="{StaticResource SliderLabel}" />
                    </DockPanel>
                    <Slider Style="{StaticResource EditSlider}" Tag="Tint" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                            Value="{Binding Tint}" AutomationProperties.Name="Tint" ToolTip="Greener ← → more magenta" />

                    <DockPanel>
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Vibrance, StringFormat={}{0:+0;-0;0}}" />
                        <TextBlock Text="Vibrance" Style="{StaticResource SliderLabel}" />
                    </DockPanel>
                    <Slider Style="{StaticResource EditSlider}" Tag="Vibrance" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                            Value="{Binding Vibrance}" AutomationProperties.Name="Vibrance" ToolTip="Mostly affects muted colours" />

                    <DockPanel>
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Saturation, StringFormat={}{0:+0;-0;0}}" />
                        <TextBlock Text="Saturation" Style="{StaticResource SliderLabel}" />
                    </DockPanel>
                    <Slider Style="{StaticResource EditSlider}" Tag="Saturation" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                            Value="{Binding Saturation}" AutomationProperties.Name="Saturation" />

                    <!-- Crop and straighten -->
                    <TextBlock Text="Crop and straighten" Style="{StaticResource Section}" />
                    <WrapPanel Margin="0,0,0,6">
                        <ToggleButton Content="Crop (R)" IsChecked="{Binding IsCropMode}" Margin="0,0,6,6" AutomationProperties.Name="Crop mode"
                                      ToolTip="Shows the whole frame; drag the rectangle or its corners. Arrow keys move it, Ctrl+arrows resize." />
                        <Button Content="⟲" Command="{Binding RotateLeftCommand}" Margin="0,0,6,6" ToolTip="Rotate 90° counter-clockwise" AutomationProperties.Name="Rotate left" />
                        <Button Content="⟳" Command="{Binding RotateRightCommand}" Margin="0,0,6,6" ToolTip="Rotate 90° clockwise" AutomationProperties.Name="Rotate right" />
                        <Button Content="Reset crop" Command="{Binding ResetCropCommand}" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Text="Aspect ratio" Style="{StaticResource SliderLabel}" Margin="0,0,0,4" />
                    <WrapPanel Margin="0,0,0,8" AutomationProperties.Name="Crop aspect ratio">
                        <RadioButton Style="{StaticResource Chip}" GroupName="CropAspect" Content="Free" Margin="0,0,4,4"
                                     IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Free}}" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="CropAspect" Content="Original" Margin="0,0,4,4"
                                     IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Original}}" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="CropAspect" Content="1:1" Margin="0,0,4,4" AutomationProperties.Name="Square"
                                     IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Square}}" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="CropAspect" Content="4:5" Margin="0,0,4,4" AutomationProperties.Name="4 by 5 portrait"
                                     IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Portrait4x5}}" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="CropAspect" Content="3:2" Margin="0,0,4,4" AutomationProperties.Name="3 by 2"
                                     IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Classic3x2}}" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="CropAspect" Content="16:9" Margin="0,0,4,4" AutomationProperties.Name="16 by 9"
                                     IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:CropAspect.Wide16x9}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding CropText}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,0,0,8" />
                    <DockPanel>
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Straighten, StringFormat={}{0:+0.0;-0.0;0.0}°}" />
                        <TextBlock Text="Straighten" Style="{StaticResource SliderLabel}" />
                    </DockPanel>
                    <Slider Style="{StaticResource EditSlider}" Tag="Straighten" Minimum="-45" Maximum="45" SmallChange="0.1" LargeChange="1"
                            Value="{Binding Straighten}" AutomationProperties.Name="Straighten"
                            ToolTip="Rotates the picture and crops in so no blank corners show" />

                    <!-- Presets -->
                    <TextBlock Text="Presets" Style="{StaticResource Section}" />
                    <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Margin="0,0,0,6"
                             MinHeight="48" MaxHeight="140" AutomationProperties.Name="Preset to apply" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Apply" Command="{Binding ApplyPresetCommand}" Margin="0,0,6,0" />
                        <Button Content="Delete" Command="{Binding DeletePresetCommand}" ToolTip="Delete the selected preset (edits already applied stay)" />
                    </StackPanel>
                    <TextBlock Text="Save current settings as a preset" Style="{StaticResource SliderLabel}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,0,0,6"
                             AutomationProperties.Name="New preset name" />
                    <WrapPanel Margin="0,0,0,6">
                        <CheckBox Content="Exposure" IsChecked="{Binding PresetIncludesExposure}" Margin="0,0,10,4" />
                        <CheckBox Content="White balance" IsChecked="{Binding PresetIncludesWhiteBalance}" Margin="0,0,10,4" />
                        <CheckBox Content="Tone" IsChecked="{Binding PresetIncludesTone}" Margin="0,0,10,4" ToolTip="Contrast, highlights, shadows" />
                        <CheckBox Content="Colour" IsChecked="{Binding PresetIncludesColour}" Margin="0,0,10,4" ToolTip="Saturation, vibrance" />
                        <CheckBox Content="Crop and rotation" IsChecked="{Binding PresetIncludesGeometry}" Margin="0,0,10,4" />
                    </WrapPanel>
                    <Button Content="Save preset" HorizontalAlignment="Left" Command="{Binding SavePresetCommand}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
