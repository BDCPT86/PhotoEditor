<UserControl x:Class="FrameForge.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FrameForge.App.ViewModels"
             xmlns:views="clr-namespace:FrameForge.App.Views"
             xmlns:controls="clr-namespace:FrameForge.App.Controls"
             xmlns:shortcuts="clr-namespace:FrameForge.App.Shortcuts"
             xmlns:library="clr-namespace:FrameForge.Core.Library;assembly=FrameForge.Core"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:conv="clr-namespace:FrameForge.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             shortcuts:ShortcutBehavior.Handler="{Binding}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="I" Command="{Binding ImportCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <!-- ============================== Grid mode ============================== -->
        <Grid x:Name="GridMode">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="_Import folder…" Command="{Binding ImportCommand}"
                        ToolTip="Import a folder of JPEG photos (Ctrl+I)" />
                <CheckBox DockPanel.Dock="Left" Margin="16,0,0,0" Content="Include _subfolders"
                          IsChecked="{Binding IncludeSubfolders}" IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBool}}" />

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="24,0,0,0"
                            Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Width="180" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                 Value="{Binding ImportProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsImportProgressIndeterminate}"
                                 AutomationProperties.Name="Import progress" />
                    <TextBlock Margin="12,0" VerticalAlignment="Center" Text="{Binding ImportProgressText}"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               AutomationProperties.AutomationId="ImportStatus" />
                    <Button Content="Cancel" Command="{Binding ImportCancelCommand}" ToolTip="Stop the import; photos read so far are kept" />
                </StackPanel>

                <Button DockPanel.Dock="Left" Margin="16,0,0,0" Content="_Analyze" Command="{Binding Analysis.AnalyzeCommand}"
                        ToolTip="Measure sharpness and exposure, and find duplicates (heuristics, not AI). Already-analysed photos are skipped." />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0" DataContext="{Binding Analysis}"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Width="140" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                 Value="{Binding ProgressValue, Mode=OneWay}" AutomationProperties.Name="Analysis progress" />
                    <TextBlock Margin="12,0" VerticalAlignment="Center" Text="{Binding ProgressText}"
                               Foreground="{StaticResource Brush.Text.Secondary}" AutomationProperties.AutomationId="AnalysisStatus" />
                    <Button Content="Cancel" Command="{Binding AnalyzeCancelCommand}" ToolTip="Stop; results so far are kept" />
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="Shortcuts (F1)" Margin="8,0,0,0"
                        Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.ToggleHelp}"
                        ToolTip="Show keyboard shortcuts" />
                <Button DockPanel.Dock="Right" Content="_Export…" Margin="8,0,0,0" Command="{Binding OpenExportCommand}"
                        ToolTip="Copy kept photos, export edited JPEGs, or save a selection manifest" />
                <Button DockPanel.Dock="Right" Content="_Presets…" Margin="8,0,0,0" Command="{Binding OpenPresetsCommand}"
                        ToolTip="Apply a saved edit preset to the selected photos" />
                <Button DockPanel.Dock="Right" Content="_Compare (C)" Margin="8,0,0,0" Command="{Binding OpenCompareCommand}"
                        ToolTip="Compare 2–4 selected photos side by side" />
            </DockPanel>

            <!-- Filter and sort -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,10" DataContext="{Binding Filter}" AutomationProperties.Name="Filter and sort">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                    <TextBlock Text="SHOW" Style="{StaticResource Text.ChipGroupLabel}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="State" Content="All" IsChecked="{Binding State, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:StateFilterChoice.All}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="State" Content="Unset" IsChecked="{Binding State, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:StateFilterChoice.Unset}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="State" Content="✓ Keep" AutomationProperties.Name="Keep" IsChecked="{Binding State, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:StateFilterChoice.Keep}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="State" Content="? Review" AutomationProperties.Name="Review" IsChecked="{Binding State, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:StateFilterChoice.Review}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="State" Content="✕ Reject" AutomationProperties.Name="Reject" IsChecked="{Binding State, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:StateFilterChoice.Reject}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="State" Content="⚠ Problems" AutomationProperties.Name="Problems" IsChecked="{Binding State, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:StateFilterChoice.Problems}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                    <TextBlock Text="RATING" Style="{StaticResource Text.ChipGroupLabel}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Rating" Content="Any" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.Any}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Rating" Content="★+" AutomationProperties.Name="1 star or more" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.One}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Rating" Content="★★+" AutomationProperties.Name="2 stars or more" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.Two}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Rating" Content="★★★+" AutomationProperties.Name="3 stars or more" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.Three}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Rating" Content="★★★★+" AutomationProperties.Name="4 stars or more" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.Four}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Rating" Content="★★★★★" AutomationProperties.Name="5 stars" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.Five}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                    <TextBlock Text="LABEL" Style="{StaticResource Text.ChipGroupLabel}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Label" Content="Any" IsChecked="{Binding Label, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:LabelFilterChoice.Any}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Label" Content="Red" IsChecked="{Binding Label, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:LabelFilterChoice.Red}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Label" Content="Yellow" IsChecked="{Binding Label, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:LabelFilterChoice.Yellow}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Label" Content="Green" IsChecked="{Binding Label, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:LabelFilterChoice.Green}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Label" Content="Blue" IsChecked="{Binding Label, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:LabelFilterChoice.Blue}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,4" ToolTip="Heuristic measurements, not AI. Run Analyze first.">
                    <TextBlock Text="ANALYSIS" Style="{StaticResource Text.ChipGroupLabel}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Analysis" Content="Any" AutomationProperties.Name="Any analysis" IsChecked="{Binding Analysis, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AnalysisFilterChoice.Any}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Analysis" Content="≈ Blurry?" AutomationProperties.Name="Likely blurry" IsChecked="{Binding Analysis, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AnalysisFilterChoice.LikelyBlurry}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Analysis" Content="◐ Clipping" AutomationProperties.Name="Clipping" IsChecked="{Binding Analysis, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AnalysisFilterChoice.Clipping}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Analysis" Content="▣ Similar groups" AutomationProperties.Name="Similar groups" IsChecked="{Binding Analysis, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AnalysisFilterChoice.InGroup}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Analysis" Content="= Duplicates" AutomationProperties.Name="Exact duplicates" IsChecked="{Binding Analysis, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AnalysisFilterChoice.ExactDuplicate}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Analysis" Content="AI pick" AutomationProperties.Name="AI suggested picks" ToolTip="AI suggestions are advisory and not yet evaluated" IsChecked="{Binding Analysis, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AnalysisFilterChoice.AiPick}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Analysis" Content="AI faces soft" AutomationProperties.Name="AI faces soft" ToolTip="AI suggestions are advisory and not yet evaluated" IsChecked="{Binding Analysis, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AnalysisFilterChoice.AiFacesSoft}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Analysis" Content="Auto-applied" AutomationProperties.Name="Changed by the last Auto run" ToolTip="Photos the last Auto run changed (cleared on restart)" IsChecked="{Binding Analysis, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AnalysisFilterChoice.AutoApplied}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="SORT" Style="{StaticResource Text.ChipGroupLabel}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Sort" Content="Folder" IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static library:LibrarySort.FolderAndName}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Sort" Content="Captured" IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static library:LibrarySort.CaptureTime}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Sort" Content="Name" IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static library:LibrarySort.FileName}}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Sort" Content="Rating" IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static library:LibrarySort.Rating}}" />
                </StackPanel>
            </WrapPanel>

            <!-- Count (right) and status: glyph + text, so warnings are not conveyed by colour alone. -->
            <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0" Text="{Binding CountText}"
                       Foreground="{StaticResource Brush.Text.Secondary}"
                       AutomationProperties.AutomationId="LibraryCount" />
            <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="LibraryStatus">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                        <Setter Property="Text" Value="{Binding StatusMessage}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}" />
                                <Setter Property="Text" Value="{Binding StatusMessage, StringFormat='⚠ {0}'}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </DockPanel>

            <!-- Empty states -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Your library is empty" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Secondary}" TextAlignment="Center"
                           Text="Import a folder of JPEG photos to start. Originals stay where they are and are never modified." />
            </StackPanel>
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="No photos match this filter" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Secondary}" TextAlignment="Center" Text="Choose “All” to see every photo." />
            </StackPanel>

            <!-- Photo grid: virtualised and recycled. Extended selection: Shift/Ctrl+click, Shift+arrows. -->
            <controls:PhotoGridListBox x:Name="PhotoGrid" Grid.Row="3"
                     ItemsSource="{Binding Photos}"
                     SelectedItem="{Binding SelectedPhoto}"
                     Background="Transparent" BorderThickness="0"
                     controls:ListBoxBehaviors.ScrollSelectionIntoView="True"
                     controls:ListBoxBehaviors.SelectedItemsSink="{Binding}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     VirtualizingPanel.CacheLength="1"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Extended"
                     IsTextSearchEnabled="False"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     AutomationProperties.Name="Photos">
                <ListBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding OpenViewerCommand}" />
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource PhotoTileItem}">
                        <!-- Screen readers announce the file name, problem state and decision. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding AccessibleStatus}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel ItemSize="192,184" SpacingMode="Uniform" StretchItems="False" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PhotoTileViewModel}">
                        <Grid x:Name="Tile" ToolTip="{Binding ToolTipText}" Background="Transparent">
                            <Grid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick"
                                              Command="{Binding DataContext.OpenViewerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding}" />
                            </Grid.InputBindings>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="ImageArea" Background="{StaticResource Brush.Surface.Sunken}" CornerRadius="2">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Status.Error}" TextAlignment="Center"
                                               Text="{Binding StatusText, StringFormat='⚠&#x0a;{0}'}"
                                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Heuristic analysis badges (glyph + word). Press I for the numbers behind them. -->
                                    <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" IsHitTestVisible="False"
                                               Visibility="{Binding HasAnalysisBadges, Converter={StaticResource BoolToVisibility}}">
                                        <Border Style="{StaticResource AnalysisBadge}" Visibility="{Binding ShowBlurBadge, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="≈ blurry?" Foreground="{StaticResource Brush.Decision.Review}" />
                                        </Border>
                                        <Border Style="{StaticResource AnalysisBadge}" Visibility="{Binding ShowClipBadge, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="◐ clip" />
                                        </Border>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource AnalysisBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GroupBadgeText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="{Binding GroupBadgeText}" />
                                        </Border>
                                        <Border Style="{StaticResource AnalysisBadge}" Visibility="{Binding ShowSharpestBadge, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="◆ sharpest" Foreground="{StaticResource Brush.Decision.Keep}" />
                                        </Border>
                                        <Border Style="{StaticResource AnalysisBadge}" Visibility="{Binding ShowExactBadge, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="= duplicate" />
                                        </Border>
                                        <Border ToolTip="Faces found by AI (advisory)">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource AnalysisBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FaceBadgeText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="{Binding FaceBadgeText}" />
                                        </Border>
                                        <Border Style="{StaticResource AnalysisBadge}" ToolTip="All faces look soft (AI, advisory)" Visibility="{Binding ShowFacesSoftBadge, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="AI faces soft" />
                                        </Border>
                                        <Border Style="{StaticResource AnalysisBadge}" ToolTip="AI suggested pick in its group (advisory; your decision is unchanged)" Visibility="{Binding ShowAiPickBadge, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="AI pick" Foreground="{StaticResource Brush.Decision.Keep}" />
                                        </Border>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <DockPanel Grid.Row="1" Margin="2,6,2,0" LastChildFill="True">
                                <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource DecisionBadges}" Focusable="False" IsTabStop="False" />
                                <TextBlock DockPanel.Dock="Left" Text="✎" Margin="0,0,4,0" FontSize="12" VerticalAlignment="Center" ToolTip="Edited (the original file is unchanged)"
                                           Foreground="{StaticResource Brush.Accent}" Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <!-- Rejected photos recede; the ✕ glyph carries the meaning, not the dimming. -->
                            <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                <Setter TargetName="ImageArea" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </controls:PhotoGridListBox>
        </Grid>

        <!-- ============================== Viewer / Compare (overlay the grid; scroll position is kept) -->
        <Grid Visibility="{Binding IsViewerOpen, Converter={StaticResource BoolToVisibility}}">
            <views:ViewerView x:Name="ViewerHost" DataContext="{Binding Viewer}" />
        </Grid>
        <Grid Visibility="{Binding IsCompareOpen, Converter={StaticResource BoolToVisibility}}">
            <views:CompareView x:Name="CompareHost" DataContext="{Binding Compare}" />
        </Grid>

        <!-- ============================== Side panels (non-modal) -->
        <views:ExportPanel DataContext="{Binding Export}" HorizontalAlignment="Right"
                           Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
        <views:PresetPanel DataContext="{Binding Presets}" HorizontalAlignment="Right"
                           Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />

        <!-- Analysis details: the numbers, thresholds and method behind every badge. -->
        <Border Style="{StaticResource SidePanel}" DataContext="{Binding Analysis}"
                Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Close" MinWidth="0"
                            Command="{Binding DataContext.RunShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{x:Static shortcuts:CullingAction.ToggleDetails}" />
                    <TextBlock Text="Analysis details" Style="{StaticResource Text.SectionLabel}" FontSize="16" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding DetailsTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                           AutomationProperties.AutomationId="DetailsTitle" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding HeuristicNote}" Style="{StaticResource Text.Secondary}" FontSize="11" Margin="0,0,0,12" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Details}" Focusable="False" AutomationProperties.Name="Analysis findings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Topic}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Topic, StringFormat='⚠ {0}'}" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Decision.Review}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Style="{StaticResource Text.Secondary}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource SidePanel}" AutomationProperties.Name="Keyboard shortcuts"
                Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Close" MinWidth="0"
                            Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.ToggleHelp}" />
                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Text.SectionLabel}" FontSize="16" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding ShortcutHelp}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type shortcuts:ShortcutHelpGroup}">
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Secondary}" FontSize="11" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type shortcuts:ShortcutHelpItem}">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Keys}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Text.Secondary}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
