<UserControl x:Class="FrameForge.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FrameForge.App.ViewModels"
             xmlns:views="clr-namespace:FrameForge.App.Views"
             xmlns:controls="clr-namespace:FrameForge.App.Controls"
             xmlns:shortcuts="clr-namespace:FrameForge.App.Shortcuts"
             xmlns:library="clr-namespace:FrameForge.Core.Library;assembly=FrameForge.Core"
             xmlns:settings="clr-namespace:FrameForge.Core.Settings;assembly=FrameForge.Core"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:conv="clr-namespace:FrameForge.App.Converters"
             xmlns:decisions="clr-namespace:FrameForge.Core.Decisions;assembly=FrameForge.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             shortcuts:ShortcutBehavior.Handler="{Binding}"
             AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />

        <!-- Toolbar action: icon + label, quiet until hovered -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource Button.Quiet}">
            <Setter Property="Padding" Value="10,5,12,5" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
        <Style x:Key="ToolbarIcon" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        </Style>
        <!-- Inline caption before a filter group ("Rating", "Label") -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <!-- A filter group turns its caption accent while it narrows the view (Tag = active) -->
        <Style x:Key="FilterGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,24,8" />
        </Style>
        <Style x:Key="FilterGroupLabel" TargetType="TextBlock" BasedOn="{StaticResource FilterLabel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Marks that only matter on a closer look: shown while the tile is hovered or selected -->
        <Style x:Key="RevealOnHover" TargetType="WrapPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Shown by the lazy tile parts below until a trigger gives them a template: builds nothing. -->
        <DataTemplate x:Key="TileNothing" />
        <!-- A tile's analysis marks. Applied only to tiles that have some (see the grid), so the many tiles without
             any don't build and style these elements: that made switching views and sorting slow. -->
        <DataTemplate x:Key="TileAnalysisBadges" DataType="{x:Type vm:PhotoTileViewModel}">
            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,28,0">
                <Border Style="{StaticResource AnalysisBadge}" ToolTip="AI suggested pick in its group (advisory; your decision is unchanged)"
                        Visibility="{Binding ShowAiPickBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="AI pick" Foreground="{StaticResource Brush.Decision.Keep}" />
                </Border>
                <Border Style="{StaticResource AnalysisBadge}" ToolTip="Sharpest in its similar group"
                        Visibility="{Binding ShowSharpestBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="◆" Foreground="{StaticResource Brush.Decision.Keep}" />
                </Border>
                <Border Style="{StaticResource AnalysisBadge}" ToolTip="Likely blurry (heuristic)"
                        Visibility="{Binding ShowBlurBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="≈ blur" Foreground="{StaticResource Brush.Decision.Review}" />
                </Border>
                <!-- Informational marks (clipping, group size, faces) appear on hover or selection, so scanning stays quiet -->
                <WrapPanel Style="{StaticResource RevealOnHover}">
                <Border Style="{StaticResource AnalysisBadge}" ToolTip="Highlights or shadows clipped"
                        Visibility="{Binding ShowClipBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="◐" />
                </Border>
                <Border ToolTip="In a group of similar photos (G selects the group)">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource AnalysisBadge}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GroupBadgeText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="{Binding GroupBadgeText}" />
                </Border>
                </WrapPanel>
                <Border Style="{StaticResource AnalysisBadge}" ToolTip="Exact duplicate of another file"
                        Visibility="{Binding ShowExactBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="= dup" />
                </Border>
                <WrapPanel Style="{StaticResource RevealOnHover}">
                <Border ToolTip="Faces found by AI (advisory)">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource AnalysisBadge}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FaceBadgeText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="{Binding FaceBadgeText}" />
                </Border>
                </WrapPanel>
                <Border Style="{StaticResource AnalysisBadge}" ToolTip="All faces look soft (AI, advisory)"
                        Visibility="{Binding ShowFacesSoftBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="☺ soft" Foreground="{StaticResource Brush.Decision.Review}" />
                </Border>
            </WrapPanel>
        </DataTemplate>
        <!-- A tile's problem (Offline, Missing, Unreadable), also applied only where there is one. Without a thumbnail the
             centred text says it; with one, the badge on the photo does. -->
        <DataTemplate x:Key="TileProblemText" DataType="{x:Type vm:PhotoTileViewModel}">
            <TextBlock FontSize="{StaticResource FontSize.Meta}" Foreground="{StaticResource Brush.Status.Error}" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="8,0" Text="{Binding StatusText, StringFormat='⚠&#x0a;{0}'}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <!-- RAW + JPEG pair (M09): an informational mark, so only built while the tile is hovered or selected -->
        <DataTemplate x:Key="TilePairMark" DataType="{x:Type vm:PhotoTileViewModel}">
            <Border Style="{StaticResource AnalysisBadge}" Margin="0,0,4,1" ToolTip="{Binding PairToolTip}" AutomationProperties.AutomationId="TilePairMark">
                <TextBlock Style="{StaticResource Text.AnalysisBadge}" Text="RAW+JPEG" Foreground="{StaticResource Brush.Text.Secondary}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TileProblemBadge" DataType="{x:Type vm:PhotoTileViewModel}">
            <Border Margin="4,0,0,1">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AnalysisBadge}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Style="{StaticResource Text.AnalysisBadge}" Foreground="{StaticResource Brush.Status.Warning}"
                           Text="{Binding StatusText, StringFormat='⚠ {0}'}" />
            </Border>
        </DataTemplate>
        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="SelectedValuePath" Value="Tag" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="I" Command="{Binding ImportCommand}" />
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ChangeDensityCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ChangeDensityCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ChangeDensityCommand}" CommandParameter="-1" />
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ChangeDensityCommand}" CommandParameter="-1" />
    </UserControl.InputBindings>

    <!-- Side panels sit in their own column, so they push the grid and viewer aside instead of covering it. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Grid mode -->
        <Grid x:Name="GridMode">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: what you are looking at (view, folder, count) and the four primary actions -->
            <Border Grid.Row="0" Background="{StaticResource Brush.Chrome}" Padding="24,12,16,8">
                <controls:SplitToolbarPanel Gap="24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ViewTitle}" Style="{StaticResource Text.PageTitle}" Margin="0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="520" AutomationProperties.AutomationId="ViewTitle" />
                        <TextBlock Text="{Binding ShownCountText}" Margin="12,4,0,0" FontSize="{StaticResource FontSize.Body}" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Tertiary}" Typography.NumeralAlignment="Tabular"
                                   AutomationProperties.AutomationId="ShownCount" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Import, with its one option behind the chevron -->
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ImportCommand}" Margin="0"
                                ToolTip="Import a folder of JPEG photos (Ctrl+I). You can also drop a folder on the window."
                                AutomationProperties.Name="Import folder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8B5;" />
                                <AccessText Text="_Import" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportOptions" Style="{StaticResource Button.Icon}" Width="22" Margin="0" FontSize="9" Content="&#xE70D;"
                                ToolTip="Import options" AutomationProperties.Name="Import options" Click="OnImportOptionsClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Include _subfolders" IsCheckable="True" IsChecked="{Binding IncludeSubfolders}"
                                              IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBool}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding Analysis.AnalyzeCommand}" Margin="8,0,0,0"
                                ToolTip="Measure sharpness and exposure, and find duplicates (heuristics, not AI). Already-analysed photos are skipped."
                                AutomationProperties.Name="Analyze">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE9D9;" />
                                <AccessText Text="_Analyze" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenCompareCommand}"
                                ToolTip="Compare 2–4 selected photos side by side (C)" AutomationProperties.Name="Compare">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8A9;" />
                                <AccessText Text="_Compare" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenPresetsCommand}"
                                ToolTip="Apply a saved edit preset, or Auto, to the selected photos" AutomationProperties.Name="Presets">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE790;" />
                                <AccessText Text="_Presets" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenExportCommand}"
                                ToolTip="Copy kept photos, export edited JPEGs, or save a selection manifest" AutomationProperties.Name="Export">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xEDE1;" />
                                <AccessText Text="_Export" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Icon}" Margin="10,0,0,0" Content="&#xE897;" AutomationProperties.Name="Keyboard shortcuts"
                                Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.ToggleHelp}"
                                ToolTip="Keyboard shortcuts (F1)" />
                    </StackPanel>
                </controls:SplitToolbarPanel>
            </Border>

            <!-- Secondary row: refine (rating, label, analysis), then how the grid is ordered and sized -->
            <Border Grid.Row="1" Background="{StaticResource Brush.Chrome}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="24,4,16,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,8" VerticalAlignment="Top">
                        <TextBlock Text="Sort" Style="{StaticResource FilterLabel}" />
                        <ComboBox Style="{StaticResource FilterCombo}" MinWidth="120" DataContext="{Binding Filter}" SelectedValue="{Binding Sort}"
                                  AutomationProperties.Name="Sort by">
                            <ComboBoxItem Content="Folder" Tag="{x:Static library:LibrarySort.FolderAndName}" />
                            <ComboBoxItem Content="Capture time" Tag="{x:Static library:LibrarySort.CaptureTime}" />
                            <ComboBoxItem Content="File name" Tag="{x:Static library:LibrarySort.FileName}" />
                            <ComboBoxItem Content="Rating" Tag="{x:Static library:LibrarySort.Rating}" />
                        </ComboBox>
                        <!-- Thumbnail size: three steps, Ctrl+− / Ctrl+= -->
                        <Border Style="{StaticResource SegmentGroup}" Margin="16,0,0,0" AutomationProperties.Name="Thumbnail size" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Density" ToolTip="Small thumbnails (Ctrl+−)" AutomationProperties.Name="Small thumbnails"
                                             IsChecked="{Binding Density, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static settings:GridDensity.Compact}}">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE80A;" FontSize="10" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Density" ToolTip="Medium thumbnails" AutomationProperties.Name="Medium thumbnails"
                                             IsChecked="{Binding Density, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static settings:GridDensity.Medium}}">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE80A;" FontSize="12" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Density" ToolTip="Large thumbnails (Ctrl+=)" AutomationProperties.Name="Large thumbnails"
                                             IsChecked="{Binding Density, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static settings:GridDensity.Large}}">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE80A;" FontSize="14" />
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <WrapPanel DataContext="{Binding Filter}" AutomationProperties.Name="Refine">
                        <StackPanel Style="{StaticResource FilterGroup}" Tag="{Binding IsRatingActive}">
                            <TextBlock Text="Rating" Style="{StaticResource FilterGroupLabel}" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Rating" Content="Any" AutomationProperties.Name="Any rating" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.Any}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Rating" Content="1★" AutomationProperties.Name="1 star or more" ToolTip="1 star or more" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.One}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Rating" Content="2★" AutomationProperties.Name="2 stars or more" ToolTip="2 stars or more" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.Two}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Rating" Content="3★" AutomationProperties.Name="3 stars or more" ToolTip="3 stars or more" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.Three}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Rating" Content="4★" AutomationProperties.Name="4 stars or more" ToolTip="4 stars or more" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.Four}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Rating" Content="5★" AutomationProperties.Name="5 stars" ToolTip="5 stars" IsChecked="{Binding MinRating, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:RatingFilterChoice.Five}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FilterGroup}" Tag="{Binding IsLabelActive}">
                            <TextBlock Text="Label" Style="{StaticResource FilterGroupLabel}" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Label" Content="Any" AutomationProperties.Name="Any label" IsChecked="{Binding Label, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:LabelFilterChoice.Any}}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Label" AutomationProperties.Name="Red" ToolTip="Red label (6)" IsChecked="{Binding Label, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:LabelFilterChoice.Red}}">
                                        <Ellipse Style="{StaticResource LabelSwatch}" Fill="{StaticResource Brush.Label.Red}" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Label" AutomationProperties.Name="Yellow" ToolTip="Yellow label (7)" IsChecked="{Binding Label, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:LabelFilterChoice.Yellow}}">
                                        <Ellipse Style="{StaticResource LabelSwatch}" Fill="{StaticResource Brush.Label.Yellow}" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Label" AutomationProperties.Name="Green" ToolTip="Green label (8)" IsChecked="{Binding Label, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:LabelFilterChoice.Green}}">
                                        <Ellipse Style="{StaticResource LabelSwatch}" Fill="{StaticResource Brush.Label.Green}" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Label" AutomationProperties.Name="Blue" ToolTip="Blue label (9)" IsChecked="{Binding Label, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:LabelFilterChoice.Blue}}">
                                        <Ellipse Style="{StaticResource LabelSwatch}" Fill="{StaticResource Brush.Label.Blue}" />
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Analysis findings: many choices, so one drop-down rather than a long row -->
                        <StackPanel Style="{StaticResource FilterGroup}" Tag="{Binding IsAnalysisActive}"
                                    ToolTip="Heuristic measurements and advisory AI. Run Analyze first.">
                            <TextBlock Text="Analysis" Style="{StaticResource FilterGroupLabel}" />
                            <ComboBox SelectedValue="{Binding Analysis}" MinWidth="150" AutomationProperties.Name="Analysis filter">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource FilterCombo}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnalysisActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBoxItem Content="Any" Tag="{x:Static vm:AnalysisFilterChoice.Any}" AutomationProperties.Name="Any analysis" />
                                <ComboBoxItem Content="Likely blurry" Tag="{x:Static vm:AnalysisFilterChoice.LikelyBlurry}" />
                                <ComboBoxItem Content="Clipping" Tag="{x:Static vm:AnalysisFilterChoice.Clipping}" ToolTip="Highlights or shadows clipped" />
                                <ComboBoxItem Content="Similar groups" Tag="{x:Static vm:AnalysisFilterChoice.InGroup}" ToolTip="In a group of similar photos; shown group by group" />
                                <ComboBoxItem Content="Exact duplicates" Tag="{x:Static vm:AnalysisFilterChoice.ExactDuplicate}" ToolTip="Identical files" />
                                <ComboBoxItem Content="AI pick" Tag="{x:Static vm:AnalysisFilterChoice.AiPick}" ToolTip="AI suggestions are advisory and not yet evaluated" AutomationProperties.Name="AI suggested picks" />
                                <ComboBoxItem Content="AI: faces soft" Tag="{x:Static vm:AnalysisFilterChoice.AiFacesSoft}" ToolTip="All faces look soft (AI, advisory)" />
                                <ComboBoxItem Content="Changed by Auto" Tag="{x:Static vm:AnalysisFilterChoice.AutoApplied}" ToolTip="Photos the last Auto run changed (cleared on restart)" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Appears only while a refinement is on; the sidebar view and folder stay -->
                        <Button Style="{StaticResource Button.Link}" Content="Clear refinements" Margin="0,0,0,8"
                                Command="{Binding ClearRefinementsCommand}" ToolTip="Set rating, label and analysis back to Any"
                                Visibility="{Binding IsRefining, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Offline or missing photos where you are looking: say why, and offer Locate folder… -->
            <Border x:Name="OfflineBanner" Grid.Row="2" Background="{StaticResource Brush.Control}" Padding="24,8,16,8"
                    DataContext="{Binding Locate}" Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="OfflineBanner">
                <DockPanel>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" Foreground="{StaticResource Brush.Status.Warning}"
                               VerticalAlignment="Top" Margin="0,2,12,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Style="{StaticResource Button.Link}" Content="Locate folder…" Command="{Binding LocateBannerFolderCommand}"
                                ToolTip="Point these photos at the folder's new place, keeping decisions and edits"
                                Visibility="{Binding HasBannerFolder, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Link}" Content="Check again" Margin="16,0,0,0"
                                ToolTip="Look for the drive or folder again (F5)"
                                Command="{Binding DataContext.RunShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{x:Static shortcuts:CullingAction.Refresh}" />
                    </StackPanel>
                    <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Secondary}" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Border>

            <!-- Photo grid: virtualised and recycled. Extended selection: Shift/Ctrl+click, Shift+arrows. -->
            <controls:PhotoGridListBox x:Name="PhotoGrid" Grid.Row="3" Padding="16,12,8,12"
                     ItemsSource="{Binding Photos}"
                     SelectedItem="{Binding SelectedPhoto}"
                     Background="Transparent" BorderThickness="0"
                     controls:ListBoxBehaviors.ScrollSelectionIntoView="True"
                     controls:ListBoxBehaviors.SelectedItemsSink="{Binding}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     VirtualizingPanel.CacheLength="0.25"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Extended"
                     IsTextSearchEnabled="False"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     AutomationProperties.Name="Photos">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding OpenViewerCommand}" />
                </ListBox.InputBindings>
                <!-- Right-click a photo: the same actions as the keys, with the keys shown -->
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" InputGestureText="Enter" Command="{Binding OpenViewerCommand}" />
                        <MenuItem Header="Develop" InputGestureText="D" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.ToggleDevelop}" />
                        <MenuItem Header="Compare selected" InputGestureText="C" Command="{Binding OpenCompareCommand}" />
                        <Separator />
                        <MenuItem Header="Keep" InputGestureText="P" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.Keep}" />
                        <MenuItem Header="Review" InputGestureText="V" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.Review}" />
                        <MenuItem Header="Reject" InputGestureText="X" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.Reject}" />
                        <MenuItem Header="Clear decision" InputGestureText="U" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.Unset}" />
                        <MenuItem Header="Rating">
                            <MenuItem Header="★" InputGestureText="1" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.Rate1}" />
                            <MenuItem Header="★★" InputGestureText="2" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.Rate2}" />
                            <MenuItem Header="★★★" InputGestureText="3" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.Rate3}" />
                            <MenuItem Header="★★★★" InputGestureText="4" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.Rate4}" />
                            <MenuItem Header="★★★★★" InputGestureText="5" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.Rate5}" />
                            <Separator />
                            <MenuItem Header="No rating" InputGestureText="0" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.ClearRating}" />
                        </MenuItem>
                        <MenuItem Header="Label">
                            <MenuItem Header="Red" InputGestureText="6" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.LabelRed}" />
                            <MenuItem Header="Yellow" InputGestureText="7" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.LabelYellow}" />
                            <MenuItem Header="Green" InputGestureText="8" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.LabelGreen}" />
                            <MenuItem Header="Blue" InputGestureText="9" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.LabelBlue}" />
                            <Separator />
                            <MenuItem Header="No label" InputGestureText="Shift+0" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.ClearLabel}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Select similar group" InputGestureText="G" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.SelectGroup}" />
                        <MenuItem Header="Analysis details" InputGestureText="I" Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.ToggleDetails}" />
                        <Separator />
                        <MenuItem Header="Apply preset or Auto…" Command="{Binding OpenPresetsCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource PhotoTileItem}">
                        <!-- Screen readers announce the file name, problem state and decision. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding AccessibleStatus}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel ItemSize="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   SpacingMode="None" StretchItems="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PhotoTileViewModel}">
                        <Grid x:Name="Tile" ToolTip="{Binding ToolTipText}" Background="Transparent">
                            <Grid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick"
                                              Command="{Binding DataContext.OpenViewerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding}" />
                            </Grid.InputBindings>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- The photo. Before its thumbnail arrives the area is a quiet placeholder of the same size. -->
                            <Border x:Name="ImageArea" CornerRadius="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                <Setter Property="Background" Value="{StaticResource Brush.Control.Pressed}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <ContentPresenter Content="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter.Style>
                                            <Style TargetType="ContentPresenter">
                                                <!-- Empty until a trigger gives it its template: a presenter with content and no template shows the view model's name -->
                                                <Setter Property="ContentTemplate" Value="{StaticResource TileNothing}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource TileProblemText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentPresenter.Style>
                                    </ContentPresenter>
                                <!-- Shrinks to the photo itself, so the marks sit on its corners rather than on the letterbox -->
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image x:Name="Thumb" Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

                                    <!-- Analysis indicators: short marks on a scrim, top-left. The tooltip names each; I shows the numbers. -->
                                    <ContentPresenter Content="{Binding}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ContentPresenter.Style>
                                            <Style TargetType="ContentPresenter">
                                                <!-- Empty until a trigger gives it its template: a presenter with content and no template shows the view model's name -->
                                                <Setter Property="ContentTemplate" Value="{StaticResource TileNothing}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAnalysisBadges}" Value="True">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource TileAnalysisBadges}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentPresenter.Style>
                                    </ContentPresenter>

                                    <!-- Problem (Offline, Missing, Unreadable), bottom-left, on a photo that still has its thumbnail.
                                         Without a thumbnail the centred text behind the image says it instead. -->
                                    <ContentPresenter Content="{Binding}" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <ContentPresenter.Style>
                                            <Style TargetType="ContentPresenter">
                                                <!-- Empty until a trigger gives it its template: a presenter with content and no template shows the view model's name -->
                                                <Setter Property="ContentTemplate" Value="{StaticResource TileNothing}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource TileProblemBadge}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentPresenter.Style>
                                    </ContentPresenter>

                                    <!-- RAW + JPEG pair, bottom-right, on hover or selection like the other informational marks -->
                                    <ContentPresenter Content="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <ContentPresenter.Style>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="ContentTemplate" Value="{StaticResource TileNothing}" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPaired}" Value="True" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="ContentTemplate" Value="{StaticResource TilePairMark}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPaired}" Value="True" />
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="ContentTemplate" Value="{StaticResource TilePairMark}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentPresenter.Style>
                                    </ContentPresenter>

                                    <!-- Decision, top-right: the mark the cull is scanning for -->
                                    <Border x:Name="StateChip" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Width="20" Height="20"
                                            CornerRadius="10" Background="{StaticResource Brush.Scrim}" Visibility="Collapsed">
                                        <TextBlock x:Name="StateGlyph" Text="{Binding StateGlyph}" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                                    </Border>
                                </Grid>
                                </Grid>
                            </Border>

                            <!-- Caption: file name (hidden at the smallest size), stars and label -->
                            <DockPanel Grid.Row="1" Margin="1,5,1,0" Height="16" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RatingText}" Foreground="{StaticResource Brush.Rating}" FontSize="10" VerticalAlignment="Center" />
                                    <Border x:Name="LabelSwatch" Margin="5,0,0,0" Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                                            Background="{Binding Label, Converter={StaticResource LabelToBrush}}">
                                        <TextBlock Text="{Binding LabelLetter}" Foreground="#FF121212" FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Left" Text="✎" Margin="0,0,5,0" FontSize="{StaticResource FontSize.Caption}" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Accent.Hover}" ToolTip="Edited (the original file is unchanged)"
                                           Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock x:Name="Name" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontSize.Caption}"
                                           VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           Visibility="{Binding DataContext.ShowFileNames, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}" />
                            </DockPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <!-- Rejected photos recede; the ✕ mark carries the meaning, not the dimming. -->
                            <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.35" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Decision.State}" Value="{x:Static decisions:CullState.Keep}">
                                <Setter TargetName="StateChip" Property="Visibility" Value="Visible" />
                                <Setter TargetName="StateGlyph" Property="Foreground" Value="{StaticResource Brush.Decision.Keep}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Decision.State}" Value="{x:Static decisions:CullState.Review}">
                                <Setter TargetName="StateChip" Property="Visibility" Value="Visible" />
                                <Setter TargetName="StateGlyph" Property="Foreground" Value="{StaticResource Brush.Decision.Review}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Decision.State}" Value="{x:Static decisions:CullState.Reject}">
                                <Setter TargetName="StateChip" Property="Visibility" Value="Visible" />
                                <Setter TargetName="StateGlyph" Property="Foreground" Value="{StaticResource Brush.Decision.Reject}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LabelLetter}" Value="{x:Null}">
                                <Setter TargetName="LabelSwatch" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </controls:PhotoGridListBox>

            <!-- Loading -->
            <views:LoadingMark Grid.Row="3" Text="Loading the library…"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty: the first thing a new user sees, so it says what to do and does it -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8B9;" FontSize="40" Foreground="{StaticResource Brush.Text.Disabled}" Margin="0,0,0,20" />
                <TextBlock Text="Import a folder to start culling" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Text.Secondary}" TextAlignment="Center" LineHeight="19"
                           Text="FrameForge reads JPEGs where they are. Originals are never moved or changed; only paths, metadata and your decisions are stored." />
                <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Center" Margin="0,24,0,10" Command="{Binding ImportCommand}"
                        Content="Import folder…" AutomationProperties.Name="Import folder" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Count}" Text="or drop a folder here  ·  Ctrl+I" />
            </StackPanel>
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                        Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Nothing to show here" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Text.Secondary}" TextAlignment="Center"
                           Text="No photo matches this view and its filters. Choose another view in the sidebar, or show every photo." />
                <Button HorizontalAlignment="Center" Margin="0,20,0,0" Content="Show all photos" DataContext="{Binding Filter}"
                        Command="{Binding ClearFiltersCommand}" ToolTip="Back to All photos, every folder, no filters" />
            </StackPanel>

            <!-- Drop target: shown only while a folder is dragged over the window -->
            <Border x:Name="DropHint" Grid.Row="0" Grid.RowSpan="5" Margin="12" CornerRadius="8" Background="#E6121212"
                    BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8B5;" FontSize="32" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,12" />
                    <TextBlock x:Name="DropHintText" Text="Drop to import this folder" FontSize="{StaticResource FontSize.Panel}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Originals stay where they are" Style="{StaticResource Text.Count}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Footer: what is happening (import, analysis, last result) and the library's decision totals -->
            <Border Grid.Row="4" Background="{StaticResource Brush.Chrome}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0"
                    Padding="24,0,16,0" MinHeight="32">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{Binding DecisionSummaryText}" Style="{StaticResource Text.Count}"
                               AutomationProperties.AutomationId="LibraryCount" ToolTip="{Binding CountText}" />

                    <!-- Import progress -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,20,0"
                                Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="140" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                     Value="{Binding ImportProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsImportProgressIndeterminate}"
                                     AutomationProperties.Name="Import progress" />
                        <TextBlock Margin="10,0" Text="{Binding ImportProgressText}" Style="{StaticResource Text.Status}" Typography.NumeralAlignment="Tabular"
                                   AutomationProperties.AutomationId="ImportStatus" />
                        <Button Style="{StaticResource Button.Link}" Content="Cancel" Command="{Binding CancelImportCommand}"
                                ToolTip="Stop the import; photos read so far are kept" AutomationProperties.Name="Cancel import" />
                    </StackPanel>

                    <!-- Analysis progress -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,20,0" DataContext="{Binding Analysis}"
                                Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="140" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                     Value="{Binding ProgressValue, Mode=OneWay}" AutomationProperties.Name="Analysis progress" />
                        <TextBlock Margin="10,0" Text="{Binding ProgressText}" Style="{StaticResource Text.Status}" Typography.NumeralAlignment="Tabular"
                                   AutomationProperties.AutomationId="AnalysisStatus" />
                        <Button Style="{StaticResource Button.Link}" Content="Cancel" Command="{Binding AnalyzeCancelCommand}"
                                ToolTip="Stop; results so far are kept" AutomationProperties.Name="Cancel analysis" />
                    </StackPanel>

                    <!-- Last result: glyph + text, so warnings are not conveyed by colour alone -->
                    <TextBlock AutomationProperties.AutomationId="LibraryStatus" AutomationProperties.LiveSetting="Polite" ToolTip="{Binding StatusMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Status}">
                                <Setter Property="Text" Value="{Binding StatusMessage}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}" />
                                        <Setter Property="Text" Value="{Binding StatusMessage, StringFormat='⚠ {0}'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================== Viewer / Compare (overlay the grid; scroll position is kept) -->
        <Grid Visibility="{Binding IsViewerOpen, Converter={StaticResource BoolToVisibility}}">
            <views:ViewerView x:Name="ViewerHost" DataContext="{Binding Viewer}" />
        </Grid>
        <Grid Visibility="{Binding IsCompareOpen, Converter={StaticResource BoolToVisibility}}">
            <views:CompareView x:Name="CompareHost" DataContext="{Binding Compare}" />
        </Grid>

        <!-- ============================== Side panels (non-modal) -->
        <views:ExportPanel x:Name="ExportSide" Grid.Column="1" DataContext="{Binding Export}" HorizontalAlignment="Right"
                           Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
        <views:PresetPanel x:Name="PresetsSide" Grid.Column="1" DataContext="{Binding Presets}" HorizontalAlignment="Right"
                           Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
        <views:LocateFolderPanel x:Name="LocateSide" Grid.Column="1" DataContext="{Binding Locate}" HorizontalAlignment="Right"
                                 Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />

        <!-- Analysis details: the numbers, thresholds and method behind every indicator. -->
        <Border x:Name="DetailsSide" Grid.Column="1" Style="{StaticResource SidePanel}" DataContext="{Binding Analysis}"
                Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" Margin="0,0,-8,0"
                            ToolTip="Close (I)" AutomationProperties.Name="Close"
                            Command="{Binding DataContext.RunShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{x:Static shortcuts:CullingAction.ToggleDetails}" />
                    <TextBlock Text="Analysis details" Style="{StaticResource Text.PanelTitle}" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding DetailsTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                           AutomationProperties.AutomationId="DetailsTitle" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding HeuristicNote}" Style="{StaticResource Text.Hint}" Margin="0,0,0,16" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Details}" Focusable="False" AutomationProperties.Name="Analysis findings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Topic}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Topic, StringFormat='⚠ {0}'}" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Decision.Review}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,3,0,3" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border x:Name="HelpSide" Grid.Column="1" Style="{StaticResource SidePanel}" AutomationProperties.Name="Keyboard shortcuts"
                Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" Margin="0,0,-8,0"
                            ToolTip="Close (F1)" AutomationProperties.Name="Close"
                            Command="{Binding RunShortcutCommand}" CommandParameter="{x:Static shortcuts:CullingAction.ToggleHelp}" />
                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Text.PanelTitle}" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding ShortcutHelp}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type shortcuts:ShortcutHelpGroup}">
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Hint}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type shortcuts:ShortcutHelpItem}">
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="112" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Keys sit on a key-cap tone, so they scan as keys -->
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource Brush.Control}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Keys}" FontSize="{StaticResource FontSize.Meta}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Text.Secondary}" FontSize="{StaticResource FontSize.Meta}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
