<UserControl x:Class="FrameForge.App.Views.LocateFolderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FrameForge.App.ViewModels"
             xmlns:conv="clr-namespace:FrameForge.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LocateFolderViewModel}"
             AutomationProperties.Name="Locate folder">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SidePanel}">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" Margin="0,0,-8,0" ToolTip="Close (Esc)"
                        AutomationProperties.Name="Close" Command="{Binding CloseCommand}" />
                <TextBlock Text="Locate folder" Style="{StaticResource Text.PanelTitle}" />
            </DockPanel>

            <TextBlock Text="Was" Style="{StaticResource Text.SectionLabel}" />
            <TextBlock Text="{Binding OldFolder}" TextWrapping="Wrap" Style="{StaticResource Text.Secondary}" Margin="0,0,0,16"
                       AutomationProperties.AutomationId="LocateOld" />

            <TextBlock Text="Now" Style="{StaticResource Text.SectionLabel}" />
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Choose…" Margin="12,0,0,0" VerticalAlignment="Top"
                        Command="{Binding ChooseAgainCommand}" ToolTip="Choose the folder where these photos are now" />
                <TextBlock Text="{Binding NewFolder, TargetNullValue='Not chosen yet'}" TextWrapping="Wrap" AutomationProperties.AutomationId="LocateNew" />
            </DockPanel>

            <!-- What was found: one line per outcome that happened -->
            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,0,0,8" AutomationProperties.AutomationId="LocateLines">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LocateCountLine}">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="Line" Text="{Binding Text}" Foreground="{StaticResource Brush.Text.Primary}" Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="Hint" Text="{Binding Hint}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Brush.Status.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                                <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,16" AutomationProperties.AutomationId="LocateMessage"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMessageWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,16" AutomationProperties.Name="Looking for the photos"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Only the library changes: no file is moved or renamed. Decisions, ratings, edits and analysis stay with each photo." />

            <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}"
                    AutomationProperties.AutomationId="LocateApply" />
        </StackPanel>
    </Border>
</UserControl>
