<UserControl x:Class="FrameForge.App.Views.PresetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FrameForge.App.ViewModels"
             xmlns:conv="clr-namespace:FrameForge.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PresetPanelViewModel}"
             AutomationProperties.Name="Presets">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SidePanel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Close" MinWidth="0" Command="{Binding CloseCommand}"
                        IsEnabled="{Binding IsApplying, Converter={StaticResource InverseBool}}" />
                <TextBlock Text="Presets" Style="{StaticResource Text.SectionLabel}" FontSize="16" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Scrolls on short windows, so the Auto controls, progress and results stay reachable -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>

            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="A preset changes only the settings it was saved with. Create presets in Develop (open a photo, press D). Originals are never changed." />

            <TextBlock Text="Preset" Style="{StaticResource Text.SectionLabel}" />
            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                     MinHeight="80" MaxHeight="240" Margin="0,0,0,8" AutomationProperties.Name="Saved presets"
                     IsEnabled="{Binding IsApplying, Converter={StaticResource InverseBool}}" />
            <TextBlock FontSize="12" Margin="0,0,0,12" Text="No presets yet.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Presets.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,8" AutomationProperties.AutomationId="PresetTargetCount"
                       Text="{Binding TargetCount, StringFormat='Applies to {0:N0} selected photo(s)'}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Apply to selected" Command="{Binding ApplyCommand}" Margin="0,0,8,0" />
                <Button Content="Undo last apply" Command="{Binding UndoBatchCommand}"
                        Visibility="{Binding Edits.CanUndoBatch, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <!-- A preset with masks works them out photo by photo: say how long that takes before it starts -->
            <TextBlock Text="{Binding EstimateText}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                       Foreground="{StaticResource Brush.Text.Secondary}" AutomationProperties.AutomationId="PresetEstimate">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EstimateText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Auto on the selection: options chosen in advance, reviewed afterwards with the Auto-applied filter -->
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0"
                    IsEnabled="{Binding IsApplying, Converter={StaticResource InverseBool}}">
                <StackPanel>
                    <TextBlock Text="Auto" Style="{StaticResource Text.SectionLabel}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Runs on every selected photo, in this order. Choose the option now; review the results afterwards with the Auto-applied filter." />

                    <CheckBox Content="Light" IsChecked="{Binding AutoLight}" Margin="0,0,0,4" />
                    <Border Style="{StaticResource SegmentGroup}" Margin="22,0,0,10" IsEnabled="{Binding AutoLight}" AutomationProperties.Name="Auto light option">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="LightVariant" Content="Natural"
                                         IsChecked="{Binding LightVariant, Converter={StaticResource EnumEquals}, ConverterParameter=Natural}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="LightVariant" Content="Brighter"
                                         IsChecked="{Binding LightVariant, Converter={StaticResource EnumEquals}, ConverterParameter=Brighter}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="LightVariant" Content="Punchy"
                                         IsChecked="{Binding LightVariant, Converter={StaticResource EnumEquals}, ConverterParameter=Punchy}" />
                        </StackPanel>
                    </Border>

                    <CheckBox Content="Level (to the main line, when one is found)" IsChecked="{Binding AutoLevel}" Margin="0,0,0,10" />

                    <CheckBox Content="Crop around the main faces" IsChecked="{Binding AutoCrop}" Margin="0,0,0,4" />
                    <StackPanel Margin="22,0,0,10" IsEnabled="{Binding AutoCrop}">
                        <Border Style="{StaticResource SegmentGroup}" AutomationProperties.Name="Auto crop framing" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="CropVariant" Content="Tight"
                                             IsChecked="{Binding CropVariant, Converter={StaticResource EnumEquals}, ConverterParameter=Tight}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="CropVariant" Content="Medium"
                                             IsChecked="{Binding CropVariant, Converter={StaticResource EnumEquals}, ConverterParameter=Medium}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="CropVariant" Content="Wide"
                                             IsChecked="{Binding CropVariant, Converter={StaticResource EnumEquals}, ConverterParameter=Wide}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SegmentGroup}" AutomationProperties.Name="Auto crop ratio" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="CropRatio" Content="Original"
                                             IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter=Original}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="CropRatio" Content="1:1"
                                             IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter=1:1}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="CropRatio" Content="4:5"
                                             IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter=4:5}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="CropRatio" Content="3:2"
                                             IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter=3:2}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="CropRatio" Content="16:9"
                                             IsChecked="{Binding CropAspect, Converter={StaticResource EnumEquals}, ConverterParameter=16:9}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Content="Apply Auto to selected" HorizontalAlignment="Left" Command="{Binding ApplyAutoCommand}"
                            ToolTip="One undo step for the whole run (Undo last apply)" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}" AutomationProperties.Name="Preset progress" />
                <TextBlock Text="{Binding ProgressText}" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource Brush.Text.Secondary}"
                           Typography.NumeralAlignment="Tabular" AutomationProperties.LiveSetting="Polite" />
                <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,8,0,0" Command="{Binding CancelCommand}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,10,0,0" MaxHeight="160" Focusable="False"
                          AutomationProperties.Name="Photos the last batch could not fully handle">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{StaticResource Brush.Text.Secondary}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="PresetResult">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" />
                        <Setter Property="Text" Value="{Binding ResultText, StringFormat='✓ {0}'}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultIsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}" />
                                <Setter Property="Text" Value="{Binding ResultText, StringFormat='⚠ {0}'}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
