<UserControl x:Class="FrameForge.App.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FrameForge.App.ViewModels"
             xmlns:controls="clr-namespace:FrameForge.App.Controls"
             xmlns:views="clr-namespace:FrameForge.App.Views"
             xmlns:conv="clr-namespace:FrameForge.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ViewerViewModel}"
             Background="{StaticResource Brush.Surface.Sunken}"
             AutomationProperties.Name="Photo viewer">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Right" Command="{Binding NextCommand}" />
        <KeyBinding Key="Left" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="Home" Command="{Binding FirstCommand}" />
        <KeyBinding Key="End" Command="{Binding LastCommand}" />
        <KeyBinding Key="Escape" Command="{Binding RequestCloseCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: back, what this photo is and where it sits; its decision, zoom and Develop on the right -->
        <DockPanel Grid.Row="0" Background="{StaticResource Brush.Chrome}" Height="48">
            <Button DockPanel.Dock="Left" Style="{StaticResource Button.Quiet}" Margin="12,0,0,0" ToolTip="Back to the grid (Esc)"
                    Command="{Binding RequestCloseCommand}" AutomationProperties.Name="Back to the grid">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Grid" />
                </StackPanel>
            </Button>
            <ToggleButton DockPanel.Dock="Right" Margin="16,0,16,0" VerticalAlignment="Center" IsChecked="{Binding Develop.IsOpen, Mode=OneWay}"
                          Command="{Binding ToggleDevelopCommand}" ToolTip="Edit this photo, non-destructively (D)" AutomationProperties.Name="Develop">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE790;" Margin="0,0,8,0" />
                    <TextBlock Text="Develop" />
                </StackPanel>
            </ToggleButton>
            <Border DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource AnalysisBadge}" Background="{StaticResource Brush.Accent.Subtle}"
                    Visibility="{Binding Current.IsEdited, Converter={StaticResource BoolToVisibility}}" ToolTip="Edited (the original file is unchanged)">
                <TextBlock Text="✎ Edited" FontSize="{StaticResource FontSize.Meta}" Foreground="{StaticResource Brush.Accent.Hover}" AutomationProperties.AutomationId="ViewerEdited" />
            </Border>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Text.Count}" MinWidth="40" TextAlignment="Right"
                       Text="{Binding ZoomText, ElementName=Zoom}" AutomationProperties.AutomationId="ZoomLevel" ToolTip="Zoom (Z: fit ↔ 100%)"
                       Visibility="{Binding Develop.IsCropMode, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource Brush.Text.Secondary}"
                       Text="{Binding FaceStatus}" AutomationProperties.AutomationId="FaceStatus" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FaceStatus}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ContentControl DockPanel.Dock="Right" Margin="0,0,24,0" FontSize="15" Content="{Binding Current}"
                            ContentTemplate="{StaticResource DecisionBadges}" Focusable="False" IsTabStop="False"
                            AutomationProperties.AutomationId="ViewerDecision"
                            AutomationProperties.Name="{Binding Current.AccessibleStatus}" />
            <TextBlock DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420"
                       Text="{Binding Current.FileName}" ToolTip="{Binding Current.FilePath}" AutomationProperties.AutomationId="FileName" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Count}"
                       Text="{Binding PositionText}" AutomationProperties.AutomationId="Position" />
        </DockPanel>

        <!-- Image area, with the Develop panel on the right while editing and the Auto tray below the photo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <views:DevelopPanel Grid.Column="1" Grid.RowSpan="2" Width="320" DataContext="{Binding Develop}"
                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />

            <!-- Thumbnail placeholder while the photo loads. -->
            <Image Source="{Binding Current.Thumbnail}" Stretch="Uniform" Margin="8" Opacity="0.6"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <controls:ZoomPanImage x:Name="Zoom" FullPixelWidth="{Binding DisplayFullWidth}" FullPixelHeight="{Binding DisplayFullHeight}" SourceKey="{Binding DisplayKey}"
                                   NeedsDetail="{Binding WantsDetail, Mode=OneWayToSource}" Source="{Binding DisplayImage}" FocusRequest="{Binding FaceFocus}" AutomationProperties.Name="Photo"
                                   IsPointMode="{Binding Develop.Masks.IsRefining}" PointCommand="{Binding Develop.AddPointCommand}"
                                   Visibility="{Binding Develop.IsCropMode, Converter={StaticResource InverseBoolToVisibility}}" />

            <!-- Histogram over the photo (H), top-right, clear of the Auto tray below and the Refine hint. Hidden in Develop,
                 whose panel shows its own. -->
            <Border Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Width="248"
                    Background="{StaticResource Brush.Scrim}" CornerRadius="4" Padding="10,10,10,8" IsHitTestVisible="False"
                    Visibility="{Binding ShowFloatingHistogram, Converter={StaticResource BoolToVisibility}}">
                <views:HistogramBox DataContext="{Binding Histogram}" CurveHeight="64" />
            </Border>

            <!-- Refine: what a click does, said on the photo where the clicking happens -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Padding="12,6" CornerRadius="6"
                    Background="{StaticResource Brush.Scrim}"
                    IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding Develop.Masks.IsRefining, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text.Primary}">
                    <Run Text="Refining" Foreground="{StaticResource Brush.Text.Secondary}" />
                    <Run Text="{Binding Develop.Masks.Selected.Name, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="  ·  click adds  ·  Alt+click or right-click removes  ·  Esc stops" Foreground="{StaticResource Brush.Text.Secondary}" />
                </TextBlock>
            </Border>

            <!-- Auto level: the line the focused option makes level -->
            <controls:GuideOverlay Guide="{Binding Develop.FocusedGuide}" Image="{Binding DisplayImage}" />

            <controls:CropOverlay Margin="16" Source="{Binding Develop.DisplayImage}" Crop="{Binding Develop.Crop}"
                                  LockedRatio="{Binding Develop.LockedCropRatio}"
                                  Visibility="{Binding Develop.IsCropMode, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Padding="10,4"
                       Background="{StaticResource Brush.Scrim}" FontSize="{StaticResource FontSize.Meta}" Text="Before (original)"
                       Visibility="{Binding Develop.ShowOriginal, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                       Text="{Binding LoadingText}" Foreground="{StaticResource Brush.Text.Secondary}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- Auto suggestions, below the photo so they never hide it; focus previews, Enter applies, Esc dismisses -->
            <Border Grid.Row="1" DataContext="{Binding Develop}" HorizontalAlignment="Center" Margin="16,8,16,12" MaxWidth="760"
                    Background="{StaticResource Brush.Panel}"
                    CornerRadius="6" Padding="16,10,12,14" AutomationProperties.Name="Auto suggestions"
                    Visibility="{Binding IsSuggesting, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" Command="{Binding DismissSuggestionsCommand}"
                                ToolTip="Dismiss (Esc); nothing changes" AutomationProperties.Name="Dismiss suggestions" />
                        <TextBlock Text="{Binding SuggestionTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="← → or 1–3 to preview · Enter to apply · Esc to dismiss" />
                    </DockPanel>

                    <!-- Working -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4" Visibility="{Binding IsComputingSuggestions, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="120" Height="4" IsIndeterminate="True" VerticalAlignment="Center" AutomationProperties.Name="Working out options" />
                        <TextBlock Margin="10,0,0,0" Text="Working out options…" Foreground="{StaticResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <!-- No options: say why -->
                    <TextBlock TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Text="{Binding SuggestionMessage}"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SuggestionMessage">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuggestionMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Options -->
                    <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SuggestionItem}">
                                <Button Margin="0,0,10,0" Padding="0" MinWidth="0" Cursor="Hand"
                                        Command="{Binding DataContext.FocusSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}"
                                        MouseDoubleClick="OnSuggestionDoubleClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <StackPanel>
                                                <Border x:Name="Frame" BorderThickness="2" BorderBrush="Transparent" CornerRadius="3" Padding="2">
                                                    <Image Source="{Binding Preview}" Height="96" MaxWidth="170" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <DockPanel Margin="2,4,2,0">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Margin="0,0,6,0"
                                                               Foreground="{StaticResource Brush.Text.Disabled}" />
                                                    <TextBlock x:Name="Name" Text="{Binding Name}" Foreground="{StaticResource Brush.Text.Secondary}" />
                                                </DockPanel>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.Stroke.Hover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.Mat}" />
                                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                                                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The focused option: why, and apply -->
                    <DockPanel Margin="0,10,0,0">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FocusedSuggestion}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Command="{Binding AcceptSuggestionCommand}" VerticalAlignment="Top"
                                Content="{Binding FocusedSuggestion.Name}" ContentStringFormat="Apply “{0}”"
                                ToolTip="Apply this option (Enter). Ctrl+Z undoes it." AutomationProperties.Name="Apply the focused option" />
                        <TextBlock Text="{Binding FocusedSuggestion.Reason}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Secondary}" AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.AutomationId="SuggestionReason" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Status.Error}" AutomationProperties.AutomationId="ViewerError"
                       Text="{Binding ErrorMessage, StringFormat='⚠ {0}'}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Footer: metadata and shortcuts -->
        <DockPanel Grid.Row="2" Background="{StaticResource Brush.Chrome}" Height="32">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Count}" FontSize="{StaticResource FontSize.Caption}" Margin="16,0"
                       Text="← →  photo  ·  P X V U  decide  ·  1–5  rate  ·  D  develop  ·  F1  help  ·  Esc  grid" />
            <TextBlock Margin="20,0,0,0" Style="{StaticResource Text.Status}" Typography.NumeralAlignment="Tabular"
                       Text="{Binding Current.DetailsText}" AutomationProperties.AutomationId="PhotoDetails" />
        </DockPanel>
    </Grid>
</UserControl>
