<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Imaging uses Windows Imaging Component (WIC) through WPF's System.Windows.Media.Imaging,
    so it targets net10.0-windows. No third-party imaging packages.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameForge.Application\FrameForge.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrameForge.Imaging.Tests" />
  </ItemGroup>

</Project>
