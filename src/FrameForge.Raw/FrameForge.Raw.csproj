<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RAW files through LibRaw (third_party/libraw, LGPL-2.1, ADR 0020): file details and the embedded full-size JPEG.
    No WPF and no FrameForge dependencies, so it stays small and testable. libraw.dll is copied next to the app.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- LibraryImport (source-generated P/Invoke) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\third_party\libraw\0.22.3\libraw.dll" Link="libraw.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrameForge.Raw.Tests" />
  </ItemGroup>

</Project>
